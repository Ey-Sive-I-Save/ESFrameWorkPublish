{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "esframework://skills/es-ai-interaction-governance/intent-contract.v1",
  "title": "ES Interaction Intent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "objective", "scope", "mustPreserve", "allowedTransitions", "forbiddenTransitions", "acceptanceSignals", "counterexamples", "nonGoals", "assumptions", "unresolvedQuestions", "intentAlignmentStatus", "executionDecision", "revision", "sourceRefs"],
  "properties": {
    "contractVersion": {"const": "1"},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mustPreserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowedTransitions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbiddenTransitions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptanceSignals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "counterexamples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "nonGoals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolvedQuestions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "intentAlignmentStatus": {"enum": ["aligned", "partial", "unverifiable", "misaligned"]},
    "executionDecision": {"enum": ["allow", "analyze-only", "deny"]},
    "revision": {"type": "integer", "minimum": 1},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "priorContradictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recovery": {"type": "object", "required": ["resumeAction", "partialStatePolicy"], "additionalProperties": false, "properties": {"resumeAction": {"type": "string", "minLength": 1}, "partialStatePolicy": {"type": "string", "minLength": 1}}}
  }
}
