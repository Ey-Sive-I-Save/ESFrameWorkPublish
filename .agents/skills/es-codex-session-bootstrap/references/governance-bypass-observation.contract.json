{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "esframework://codex/governance-bypass-observation.contract.json",
  "schemaVersion": 1,
  "contractId": "es-governance-bypass-observation-v1",
  "mode": "read-only-bypass-observation",
  "allowedProfile": "StaticDevelopment",
  "allowedScope": "task:read-only",
  "allowedScopeKind": "task-object",
  "decisionIdAlgorithm": "es-governance-decision-id-v1",
  "helperPath": ".agents/skills/es-codex-session-bootstrap/scripts/Get-ESGovernanceDecisionId.ps1",
  "allowedObservationStates": ["disabled", "armed", "rolled-back"],
  "allowedRollbackStates": ["available", "armed", "rolled-back"],
  "requiredFields": [
    "profile",
    "scope",
    "scopeKind",
    "routeMode",
    "productionRouteIntegrated",
    "globalP0Integrated",
    "decisionIdAlgorithm",
    "helperPath",
    "decisionIdExpected",
    "decisionIdObserved",
    "bypassDetected",
    "observationState",
    "rollbackState",
    "observations"
  ],
  "observationCodes": [
    "BYPASS_CHECK_PASSED",
    "BYPASS_DETECTED",
    "DECISION_ID_MATCH",
    "DECISION_ID_MISMATCH",
    "ROLLBACK_AVAILABLE",
    "ROLLBACK_ARMED",
    "ROLLBACK_COMPLETED",
    "PRODUCTION_ROUTE_DISABLED",
    "GLOBAL_P0_DISABLED"
  ],
  "failureEffect": "review",
  "forbiddenProjectionFields": [
    "automationDecisionId",
    "automationDecisionStatus",
    "automationEvidenceScope",
    "automationGovernanceHash",
    "projectedDecisionId",
    "projectedEffect",
    "projectedProfile",
    "projectedScope",
    "projectedSnapshotHash"
  ],
  "recovery": "disable the bypass, preserve the exact scoped evidence, and re-run the observation from the same or newer snapshot"
}
