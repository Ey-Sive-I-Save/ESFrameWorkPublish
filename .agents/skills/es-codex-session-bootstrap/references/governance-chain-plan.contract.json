      "A": {"validationKeywords":["入口清单","范围边界","UTF-8","read-only"],"requiredChecks":["path-scope","encoding","duplicate-entry"],"negativeCases":["scope-over-budget","unreadable-source"],"evidenceReceipt":"candidate-report","verificationState":"static-passed"},
      "B": {"validationKeywords":["authoritative","P0","sourceRef","conflict","stale"],"requiredChecks":["authority-map","p0-conflict","freshness"],"negativeCases":["conflicting-p0","missing-source-ref"],"evidenceReceipt":"candidate-report","verificationState":"static-passed"},
