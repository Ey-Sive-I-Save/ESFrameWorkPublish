    {"blockId":"D","objective":"Knowledge来源与新鲜度映射","steps":[16,17,18,19,20,21],"inputs":["AIBRAIN_ENTRY.md","KnowledgeIndex.yaml","Knowledge SourceRefs"],"allowedWrites":["candidate-report"],"artifactPath":"ES/Automation/Candidates/knowledge-source-freshness-map.v1.json","budget":{"maxEntries":400,"maxSourceRefs":800},"stopConditions":["hash-drift","stale-when-hit","duplicate-authority"],"evidenceLevel":"S1-static","runtimeStatus":"not-applicable","rollback":"candidate-only"},
    {"blockId":"E","objective":"核心治理链合同","steps":[22,23,24,25,26,27],"inputs":["A-D candidate reports"],"allowedWrites":["design-contract"],"artifactPath":".agents/skills/es-codex-session-bootstrap/references/core-route.contract.json","budget":{"maxSkills":3,"maxKnowledge":3,"maxWarnings":6},"stopConditions":["ambiguous-simple-route","missing-hard-boundary"],"evidenceLevel":"S1-design","runtimeStatus":"not-applicable","rollback":"revert-design-contract"},
    {"blockId":"F","objective":"扩展治理链合同","steps":[28,29,30,31,32,33],"inputs":["A-D candidate reports","core-route contract"],"allowedWrites":["design-contract"],"artifactPath":".agents/skills/es-codex-session-bootstrap/references/extension-route.contract.json","budget":{"maxSkills":8,"maxKnowledge":12,"maxWarnings":24,"recursiveExpansion":false},"stopConditions":["budget-exceeded","unbounded-recursion","runtime-confusion"],"evidenceLevel":"S1-design","runtimeStatus":"not-applicable","rollback":"revert-design-contract"},
    {"blockId":"G","objective":"去重候选与冲突报告","steps":[34,35,36,37,38,39,40,41],"inputs":["A-D reports","E-F contracts"],"allowedWrites":["candidate-report"],"artifactPath":"ES/Automation/Candidates/governance-dedup-candidate-report.v1.json","budget":{"maxMappings":1000},"stopConditions":["authority-uncertain","migration-impact-unknown","conflict-unresolved"],"evidenceLevel":"S1-static","runtimeStatus":"not-applicable","rollback":"candidate-only-no-delete"},
    {"blockId":"H","objective":"核心链真实样例","steps":[42,43,44,45,46,47],"inputs":["core-route contract","simple read-only task"],"allowedWrites":["execution-receipt"],"artifactPath":"ES/Automation/Runs/GovernanceChain/core-route-sample.v1.json","budget":{"maxReads":80,"maxSkills":3},"stopConditions":["unexpected-extension","missing-boundary","decision-utility-drop"],"evidenceLevel":"S2-static-execution","runtimeStatus":"runtime-not-run-unless-authorized","rollback":"retain-receipt-no-source-mutation"},
    {"blockId":"I","objective":"扩展链真实样例","steps":[48,49,50,51,52,53],"inputs":["extension-route contract","cross-module task"],"allowedWrites":["execution-receipt"],"artifactPath":"ES/Automation/Runs/GovernanceChain/extension-route-sample.v1.json","budget":{"maxReads":220,"maxSkills":8},"stopConditions":["duplicate-read-over-budget","static-runtime-overclaim","unbounded-discovery"],"evidenceLevel":"S2-static-execution","runtimeStatus":"runtime-not-run-unless-authorized","rollback":"retain-receipt-no-source-mutation"},
    {"blockId":"J","objective":"Runtime能力矩阵","steps":[54,55,56,57,58,59,60,61],"inputs":["H-I receipts","runtime acceptance contracts"],"allowedWrites":["capability-matrix"],"artifactPath":"ES/Automation/Candidates/runtime-capability-matrix.v1.json","budget":{"maxCapabilities":80},"stopConditions":["runtime-status-ambiguous","missing-receipt-contract"],"evidenceLevel":"S1-static-until-runtime-receipt","runtimeStatus":"per-capability","rollback":"revert-matrix-only"},
    {"blockId":"K","objective":"评分与收尾合同","steps":[62,63,64,65,66,67,68],"inputs":["interaction governance contract","H-I receipts","J matrix"],"allowedWrites":["design-contract"],"artifactPath":".agents/skills/es-ai-interaction-governance/references/governance-score.contract.json","budget":{"maxDimensions":6},"stopConditions":["score-overrides-hard-block","missing-evidence-cap","duplicate-dimension"],"evidenceLevel":"S1-design","runtimeStatus":"not-applicable","rollback":"revert-design-contract"},
    {"blockId":"L","objective":"治理回归与收尾","steps":[69,70,71,72,73,74,75,76],"inputs":["A-K artifacts and receipts"],"allowedWrites":["final-report"],"artifactPath":"ES/Automation/Runs/GovernanceChain/final-convergence-report.v1.json","budget":{"maxScope":"affected-closure-only"},"stopConditions":["unproven-completion","scope-drift","unresolved-authority-conflict"],"evidenceLevel":"S2-static-summary","runtimeStatus":"runtime-not-run-unless-authorized","rollback":"retain-report-no-source-mutation"}
  ]
