      "H": {"validationKeywords":["core-chain","read-count","decision-utility","extension-trigger"],"requiredChecks":["deterministic-replay","read-budget","no-false-upgrade"],"negativeCases":["unexpected-extension","missing-boundary"],"evidenceReceipt":"execution-receipt","verificationState":"static-passed"},
      "I": {"validationKeywords":["extension-chain","duplicate-read","runtime-not-run","evidence-boundary"],"requiredChecks":["bounded-discovery","static-runtime-separation","replay"],"negativeCases":["recursive-load","static-as-runtime"],"evidenceReceipt":"execution-receipt","verificationState":"static-passed"},
