{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "esframework://codex/governance-decision.schema.json",
  "schemaVersion": 1,
  "title": "Scoped governance decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisionId",
    "object",
    "field",
    "profile",
    "scope",
    "scopeKind",
    "routeState",
    "evidenceState",
    "effect",
    "reasonCode",
    "predicate",
    "evidence",
    "alternativePath",
    "recovery",
    "rollback",
    "authorization",
    "snapshot"
  ],
  "properties": {
    "decisionId": { "type": "string", "pattern": "^decision-[0-9a-fA-F]{24,64}$" },
    "object": { "type": "string", "minLength": 1 },
    "field": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "scopeKind": { "enum": ["project-object", "project-global", "task-object", "context-object"] },
    "routeState": { "enum": ["core", "extension", "blocked"] },
    "evidenceState": { "enum": ["unknown", "pending", "partial", "closed", "stale", "runtime-not-run"] },
    "effect": { "enum": ["hard-block", "claim-cap", "review", "stop-next-read"] },
    "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$" },
    "predicate": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "alternativePath": { "type": "string", "minLength": 1 },
    "recovery": { "type": "string", "minLength": 1 },
    "rollback": { "type": "string", "minLength": 1 },
    "routeDepth": { "type": "integer", "minimum": 0, "maximum": 2 },
    "depthReasonCode": { "type": ["string", "null"] },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requestedAction", "requestedScope"],
      "properties": {
        "mode": { "enum": ["CurrentUserDirect", "ManagedAIBrain"] },
        "requestedAction": { "type": "string", "minLength": 1 },
        "requestedScope": { "type": "string", "minLength": 1 }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "sourceRefs", "sourceRefsHash", "registryHash", "coverage"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
            }
          }
        },
        "sourceRefsHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "registryHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["normalizationVersion", "sourceRefsHash", "registryHash", "head"],
          "properties": {
            "normalizationVersion": { "const": "path-sha256-v1" },
            "sourceRefsHash": { "const": "sorted unique canonical JSON of {path,sha256}" },
            "registryHash": { "const": "sorted canonical JSON of {path,sha256} for registryFiles" },
            "head": { "const": "current Git commit SHA" }
          }
        }
      }
    },
    "effectOverride": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fromEffect", "toEffect", "profile", "predicate", "justification", "evidenceRefs"],
      "properties": {
        "fromEffect": { "enum": ["hard-block", "claim-cap", "review", "stop-next-read"] },
        "toEffect": { "enum": ["hard-block", "claim-cap", "review", "stop-next-read"] },
        "profile": { "type": "string", "minLength": 1 },
        "predicate": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
