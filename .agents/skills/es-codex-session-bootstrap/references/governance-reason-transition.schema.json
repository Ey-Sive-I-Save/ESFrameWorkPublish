{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "esframework://codex/governance-reason-transition.schema.json",
  "schemaVersion": 1,
  "title": "Reason transition contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "contractId", "decisionModel", "defaultStatePolicy", "transitionExceptions", "forbiddenTransitions"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "$id": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "contractId": { "type": "string", "minLength": 1 },
    "decisionModel": { "const": "routeState/evidenceState/effect" },
    "defaultStatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeState", "evidenceState", "effect", "deviation"],
      "properties": {
        "routeState": { "const": "exact" },
        "evidenceState": { "const": "exact" },
        "effect": { "const": "exact" },
        "deviation": { "const": "registered-transition-and-directional-override-only" }
      }
    },
    "transitionExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reasonCode", "profileIds", "scopePattern", "from", "to", "override", "alternativePath", "recovery", "rollback"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9_.-]+$" },
          "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$" },
          "profileIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "scopePattern": { "type": "string", "pattern": "^\\^[^*]+\\$" },
          "from": { "$ref": "#/$defs/state" },
          "to": { "$ref": "#/$defs/state" },
          "override": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fromEffect", "toEffect", "profile", "predicate", "requiredEvidenceRefs"],
            "properties": {
              "fromEffect": { "$ref": "#/$defs/effect" },
              "toEffect": { "$ref": "#/$defs/effect" },
              "profile": { "type": "string", "minLength": 1 },
              "predicate": { "type": "string", "minLength": 1 },
              "requiredEvidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "alternativePath": { "type": "string", "minLength": 1 },
          "recovery": { "type": "string", "minLength": 1 },
          "rollback": { "type": "string", "minLength": 1 }
        }
      }
    },
    "forbiddenTransitions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "routeState": { "enum": ["core", "extension", "blocked"] },
    "evidenceState": { "enum": ["unknown", "pending", "partial", "closed", "stale", "runtime-not-run"] },
    "effect": { "enum": ["hard-block", "claim-cap", "review", "stop-next-read"] },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeState", "evidenceState", "effect"],
      "properties": {
        "routeState": { "$ref": "#/$defs/routeState" },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "effect": { "$ref": "#/$defs/effect" }
      }
    }
  }
}
