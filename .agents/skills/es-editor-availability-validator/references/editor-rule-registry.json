    {"ruleId":"EW-04","title":"size-bounds","applicableTo":["EditorWindow","Workbench","InspectorDrawer"],"severity":"critical","staticChecks":["minimum-size","maximum-strategy","numeric-relation"],"runtimeChecks":["narrow-wide-dpi"]},
    {"ruleId":"EW-05","title":"first-screen-conclusion","applicableTo":["EditorWindow","Workbench","InspectorDrawer"],"severity":"high","staticChecks":["title-status-primary"],"runtimeChecks":["first-screen-screenshot"]},
    {"ruleId":"EW-06","title":"phase-separation","applicableTo":["EditorWindow","Workbench"],"severity":"medium","staticChecks":["section-or-phase"],"runtimeChecks":["phase-navigation"]},
    {"ruleId":"EW-07","title":"section-identity","applicableTo":["EditorWindow","Workbench","InspectorDrawer"],"severity":"high","staticChecks":["section-id","navigator-id"],"runtimeChecks":["reselection-domain-reload"]},
    {"ruleId":"EW-08","title":"single-axis-scroll","applicableTo":["EditorWindow","Workbench","InspectorDrawer"],"severity":"high","staticChecks":["scroll-owner-or-exception"],"runtimeChecks":["horizontal-overflow"]},
    {"ruleId":"EW-09","title":"action-host-layers","applicableTo":["EditorWindow","Workbench","InspectorDrawer","MenuAction"],"severity":"medium","staticChecks":["action-host"],"runtimeChecks":["event-routing"]},
    {"ruleId":"EW-10","title":"phase-primary-action","applicableTo":["EditorWindow","Workbench","InspectorDrawer"],"severity":"medium","staticChecks":["primary-action"],"runtimeChecks":["primary-action-visibility"]},
    {"ruleId":"EW-11","title":"state-failure-closure","applicableTo":["EditorWindow","Workbench","InspectorDrawer","PreviewImport","BackgroundService"],"severity":"critical","staticChecks":["state-error-empty-recovery"],"runtimeChecks":["failure-recovery"]},
    {"ruleId":"EW-12","title":"mutation-recovery","applicableTo":["EditorWindow","Workbench","InspectorDrawer","PreviewImport"],"severity":"critical","staticChecks":["undo-dirty-write-scope"],"runtimeChecks":["undo-reopen-recovery"]},
