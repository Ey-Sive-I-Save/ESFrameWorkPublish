    {"ruleId":"EW-18","title":"preview-ownership","applicableTo":["PreviewImport","EditorWindow","Workbench"],"severity":"high","staticChecks":["preview-session-release"],"runtimeChecks":["rendertexture-cleanup"]},
    {"ruleId":"EW-19","title":"es-token","applicableTo":["EditorWindow","Workbench","InspectorDrawer"],"severity":"medium","staticChecks":["es-token-theme"],"runtimeChecks":["light-dark-contrast"]},
    {"ruleId":"EW-20","title":"long-value-accessibility","applicableTo":["EditorWindow","Workbench","InspectorDrawer","PreviewImport"],"severity":"medium","staticChecks":["long-text-path-guid-keyboard"],"runtimeChecks":["long-value-dpi"]}
