    {"ruleId":"EW-16","title":"reload-playmode","applicableTo":["EditorWindow","Workbench","InspectorDrawer","PreviewImport","BackgroundService"],"severity":"critical","staticChecks":["reload-unbind"],"runtimeChecks":["reload-domain-playmode"]},
