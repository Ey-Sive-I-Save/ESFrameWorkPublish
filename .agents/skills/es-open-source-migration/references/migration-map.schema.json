{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "mapId", "status", "source", "target", "scope", "executionContract", "mappings", "parallelism", "verification", "rollback", "owner", "evidenceRef", "staleWhen"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mapId": {"type": "string", "pattern": "^es-open-source-migration-map\\.v1$"},
    "status": {"enum": ["planned", "mapping-approved", "in-progress", "stale", "blocked", "completed"]},
    "source": {"type": "object", "required": ["repositoryUrl", "fixedRevision", "license", "isolatedRelativeLocator"], "properties": {"repositoryUrl": {"type": ["string", "null"]}, "fixedRevision": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]}, "isolatedRelativeLocator": {"type": ["string", "null"], "pattern": "^(null|\\.\\./[^/].*)$"}}},
    "target": {"type": "object", "required": ["projectRoot", "writeAllowed", "protectedPaths"], "properties": {"projectRoot": {"type": "string"}, "writeAllowed": {"const": false}, "protectedPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "scope": {"type": "object", "required": ["mode", "allowTargetMutation", "allowNetwork", "allowGitWrite", "allowDelete", "allowRename", "manualSubstitutionAllowed"], "properties": {"mode": {"enum": ["external-only", "external-checkout-in-place"]}, "allowTargetMutation": {"const": false}, "allowNetwork": {"const": false}, "allowGitWrite": {"const": false}, "allowDelete": {"type": "boolean"}, "allowRename": {"type": "boolean"}, "manualSubstitutionAllowed": {"type": "boolean"}}},
    "executionContract": {"type": "object", "required": ["mode", "wholeRepository", "renamePathSegments", "developerName", "identityHardeningVersion", "sourceLocatorPolicy", "journalPhases", "missingStagingPolicy", "planHashInputs", "fileClassification", "protectedPaths", "evidenceSeparation"], "properties": {"mode": {"enum": ["external-only", "external-checkout-in-place"]}, "wholeRepository": {"type": "boolean"}, "renamePathSegments": {"type": "boolean"}, "developerName": {"type": "string", "minLength": 1}, "identityHardeningVersion": {"type": "string", "minLength": 1}, "sourceLocatorPolicy": {"type": "string", "minLength": 1}, "journalPhases": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "missingStagingPolicy": {"type": "object", "required": ["staging", "commit-started"], "properties": {"staging": {"enum": ["recover-before-commit"]}, "commit-started": {"enum": ["fail-closed"]}}}, "planHashInputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "fileClassification": {"type": "object", "required": ["text", "binary", "opaque"], "properties": {"text": {"type": "string"}, "binary": {"type": "string"}, "opaque": {"type": "string"}}}, "protectedPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "evidenceSeparation": {"type": "object", "required": ["static", "runtime"], "properties": {"static": {"type": "string"}, "runtime": {"type": "string"}}}}},
    "mappings": {"type": "array", "items": {"type": "object", "required": ["sourceRelativePath", "targetRelativePath", "category", "status", "owner", "rollback"], "properties": {"sourceRelativePath": {"type": "string"}, "targetRelativePath": {"type": ["string", "null"]}, "category": {"enum": ["adopt", "adapt", "rewrite", "exclude", "defer"]}, "status": {"type": "string"}, "owner": {"type": ["string", "null"]}, "rollback": {"type": "string"}}}},
    "parallelism": {"type": "object", "required": ["agentStartGate", "maxAgents", "partitionKey", "sharedWriteTargets", "mergeOwner"], "properties": {"agentStartGate": {"const": "mapping-approved"}, "maxAgents": {"type": "integer", "minimum": 0}, "partitionKey": {"enum": ["assembly-or-domain", "manual"]}, "sharedWriteTargets": {"type": "array", "maxItems": 0}, "mergeOwner": {"type": ["string", "null"]}}},
    "verification": {"type": "object", "required": ["mode", "requiredChecks", "runtimeStatus"], "properties": {"mode": {"const": "dry-run"}, "requiredChecks": {"type": "array", "minItems": 1}, "runtimeStatus": {"enum": ["not-run", "partial", "verified"]}}},
    "rollback": {"type": "object", "required": ["strategy", "compatibilityWindow"], "properties": {"strategy": {"type": "string"}, "compatibilityWindow": {"type": "string"}}},
    "owner": {"type": ["string", "null"]},
    "evidenceRef": {"type": ["string", "null"]},
    "staleWhen": {"type": "string"}
  }
}
