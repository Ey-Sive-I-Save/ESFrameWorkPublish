{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "esframework://skills/es-prompt-engineering/prompt-envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "template", "invocation", "structuredOutput", "verifier", "regressionResult", "nonClaims"],
  "properties": {
    "schemaVersion": {"const": 1},
    "template": {"type": "object", "required": ["id", "version", "mode", "rawPromptHash"], "properties": {"id": {"const": "es.prompt.auto-wrap"}, "version": {"const": 1}, "mode": {"enum": ["auto-fast", "auto-safe", "raw"]}, "rawPromptHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "invocation": {"type": "object", "required": ["requestedMode", "effectiveMode", "networkAllowed", "runtimeAllowed", "writeAllowed", "maxReads", "maxAssertions"]},
    "structuredOutput": {"type": "object", "required": ["objective", "mustPreserve", "requiredReads", "acceptanceSignals", "riskSignals"]},
    "presentation": {"type": "object", "required": ["displayMode", "originalPrompt", "wrappedPrompt", "nextAction", "previewIsAuthorization"]},
    "contextInjection": {"type": "object", "required": ["count", "totalBytes", "files", "limits"]},
    "verifier": {"type": "object", "required": ["status", "assertions"]},
    "regressionResult": {"type": "object", "required": ["status", "passed", "failed"]},
    "textPolicy": {"type": "object", "required": ["charCount", "maxCharsWithoutBoundary", "sampleHeadChars", "sampleTailChars", "boundarySignalDetected", "middleScanned", "decision"]},
    "nonClaims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
