{
  "schemaVersion": 1,
  "registryId": "es.game-ui",
  "templates": {
    "hud": {"requiredZones":["safe-area"],"componentTypes":["frame","text","icon","progress","counter","cooldown","status-badge","input-hint","tooltip"]},
    "navigation": {"requiredZones":["header","content","navigation"],"componentTypes":["frame","text","tab-bar","button","list","icon","focus-ring","tooltip"]},
    "modal": {"requiredZones":["modal-frame","action-bar"],"componentTypes":["frame","text","image","button","progress","loading","error-state"]},
    "conversation": {"requiredZones":["dialogue","choices"],"componentTypes":["frame","portrait","text","choice-list","button","nameplate","subtitle"]},
    "progression": {"requiredZones":["header","content","reward"],"componentTypes":["frame","text","list","progress","badge","item-slot","button","tooltip"]},
    "collection": {"requiredZones":["header","content"],"componentTypes":["frame","tab-bar","grid","list","item-slot","item-card","detail-panel","stat-row","button","empty-state"]},
    "combat": {"requiredZones":["safe-area","action-bar"],"componentTypes":["frame","bar","progress","icon","cooldown","target-panel","damage-pop","button","input-hint"]},
    "world": {"requiredZones":["map","overlay"],"componentTypes":["frame","map","marker","list","text","tooltip","button"]},
    "system": {"requiredZones":["header","content","action-bar"],"componentTypes":["frame","tab-bar","list","slider","toggle","dropdown","button","text"]},
    "result": {"requiredZones":["header","content","action-bar"],"componentTypes":["frame","text","stat-row","list","reward-track","button","badge"]}
  },
  "components": {
    "frame": {"container":true,"requiresVisual":true},
    "text": {"container":false,"requiresText":true},
    "icon": {"container":false,"requiresAsset":true},
    "image": {"container":false,"requiresAsset":true},
    "portrait": {"container":false,"requiresAsset":true},
    "button": {"container":true,"requiresTextOrAsset":true,"interactive":true},
    "tab-bar": {"container":true,"interactive":true,"requiresChildren":true},
    "list": {"container":true,"requiresChildren":true},
    "grid": {"container":true,"requiresChildren":true},
    "choice-list": {"container":true,"requiresChildren":true,"interactive":true},
    "item-slot": {"container":true,"requiresAsset":true,"interactive":true,"stateVariants":["default","selected","locked","empty","disabled"]},
    "item-card": {"container":true,"requiresAsset":true,"interactive":true,"stateVariants":["default","selected","locked","empty","disabled"]},
    "detail-panel": {"container":true,"requiresChildren":true},
    "stat-row": {"container":true,"requiresTextOrAsset":true},
    "progress": {"container":true,"requiresNumericValue":true},
    "bar": {"container":true,"requiresNumericValue":true},
    "counter": {"container":true,"requiresNumericValue":true},
    "cooldown": {"container":true,"requiresNumericValue":true},
    "status-badge": {"container":true,"requiresTextOrAsset":true},
    "badge": {"container":true,"requiresTextOrAsset":true},
    "input-hint": {"container":true,"requiresTextOrAsset":true},
    "focus-ring": {"container":false,"requiresVisual":true},
    "nameplate": {"container":true,"requiresTextOrAsset":true},
    "subtitle": {"container":false,"requiresText":true},
    "loading": {"container":true,"requiresVisual":true},
    "error-state": {"container":true,"requiresTextOrAsset":true},
    "empty-state": {"container":true,"requiresTextOrAsset":true},
    "tooltip": {"container":true,"requiresTextOrAsset":true},
    "target-panel": {"container":true,"requiresChildren":true},
    "damage-pop": {"container":false,"requiresText":true},
    "map": {"container":true,"requiresVisual":true},
    "marker": {"container":false,"requiresAsset":true,"interactive":true},
    "slider": {"container":true,"interactive":true,"requiresNumericValue":true},
    "toggle": {"container":true,"interactive":true,"requiresTextOrAsset":true},
    "dropdown": {"container":true,"interactive":true,"requiresTextOrAsset":true},
    "reward-track": {"container":true,"requiresChildren":true}
  }
}
