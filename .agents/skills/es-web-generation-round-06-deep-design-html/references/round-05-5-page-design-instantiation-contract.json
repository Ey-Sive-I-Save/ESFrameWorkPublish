{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://web-generation/round-05-5/page-design-instantiation/v1",
  "title": "AI Page Design Instantiation",
  "type": "object",
  "required": ["objectiveBrief", "securityContract", "semanticHtml", "informationArchitecture", "visualDirection", "interactionModel", "implementationPlan", "filesToCreate", "filesToModify", "riskAssessment", "rejectedAlternatives", "provenance", "aiAnalysis", "execution", "returnReceipt", "evidence"],
  "properties": {
