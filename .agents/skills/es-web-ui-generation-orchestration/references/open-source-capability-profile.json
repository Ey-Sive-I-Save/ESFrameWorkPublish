    "interactionStateMachine": {"required": true, "events": ["load", "submit", "retry", "cancel", "navigate", "filter"], "source": ["remix", "sveltekit", "astro"]},
    "progressiveEnhancement": {"required": true, "staticFallback": "semantic-html", "source": ["astro", "sveltekit", "remix"]},
    "resumabilityBudget": {"required": true, "maxHydratedRegions": 3, "source": ["qwik", "astro"]},
    "performanceBudget": {"required": true, "lcpP75Ms": 2500, "inpP75Ms": 200, "clsP75": 0.1, "source": ["nextjs", "qwik", "nuxt"]}
