.es-agent-root {
    flex-grow: 1;
    background-color: rgb(18, 22, 29);
    color: rgb(218, 225, 235);
    min-width: 0;
}

.es-agent-header {
    min-height: 58px;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding-left: 18px;
    padding-right: 12px;
    background-color: rgb(25, 31, 41);
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 60, 76);
}

.es-agent-brand {
    flex-grow: 1;
    min-width: 180px;
    margin-left: 10px;
}

.es-agent-brand-mark {
    width: 30px;
    height: 30px;
    border-width: 1px;
    border-color: rgb(57, 205, 224);
    border-radius: 6px;
    background-color: rgb(25, 100, 116);
    color: rgb(232, 252, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 10px;
}

.es-agent-brand-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(231, 238, 247);
}

.es-agent-brand-subtitle {
    margin-top: 2px;
    font-size: 10px;
    color: rgb(121, 139, 162);
}

.es-agent-status-pill {
    min-width: 54px;
    height: 24px;
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 4px;
    background-color: rgb(38, 48, 61);
    color: rgb(151, 169, 191);
    -unity-text-align: middle-center;
    font-size: 9px;
    -unity-font-style: bold;
}

.es-agent-status-pill.running {
    background-color: rgba(42, 166, 121, 0.18);
    color: rgb(101, 226, 173);
    border-left-width: 2px;
    border-left-color: rgb(60, 207, 151);
}

.es-agent-status-pill.thinking,
.es-agent-status-pill.working,
.es-agent-status-pill.responding {
    background-color: rgba(46, 164, 196, 0.18);
    color: rgb(113, 222, 240);
    border-left-width: 2px;
    border-left-color: rgb(55, 191, 216);
}

.es-agent-status-pill.completed {
    background-color: rgba(43, 166, 121, 0.16);
    color: rgb(110, 224, 177);
    border-left-width: 2px;
    border-left-color: rgb(60, 207, 151);
}

.es-agent-status-pill.stopped {
    background-color: rgba(181, 145, 67, 0.16);
    color: rgb(224, 193, 113);
    border-left-width: 2px;
    border-left-color: rgb(205, 163, 67);
}

.es-agent-status-pill.failed {
    background-color: rgba(212, 83, 86, 0.16);
    color: rgb(244, 143, 145);
    border-left-width: 2px;
    border-left-color: rgb(224, 86, 89);
}

.es-agent-header-button {
    height: 30px;
    min-width: 54px;
    margin-left: 5px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: rgb(55, 68, 84);
    border-radius: 4px;
    background-color: rgb(33, 41, 53);
    color: rgb(202, 213, 226);
}

.es-agent-header-button:hover,
.es-agent-header-button.active {
    background-color: rgb(42, 54, 69);
    border-color: rgb(45, 181, 208);
    color: rgb(232, 246, 250);
}

.es-agent-header-button.danger:hover {
    border-color: rgb(222, 92, 95);
    color: rgb(255, 173, 175);
}

.es-agent-action-contract {
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    min-width: 0;
    margin-left: 6px;
}

.es-agent-action-scope-row,
.es-agent-action-host {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
}

.es-agent-action-scope-row {
    min-height: 30px;
    justify-content: flex-end;
}

.es-agent-action-scope-label {
    width: 34px;
    margin-right: 3px;
    color: rgb(121, 139, 162);
    font-size: 9px;
    -unity-text-align: middle-right;
}

.es-agent-workspace {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

.es-agent-sidebar {
    width: 248px;
    min-width: 192px;
    flex-shrink: 0;
    background-color: rgb(21, 26, 34);
    border-right-width: 1px;
    border-right-color: rgb(43, 52, 66);
    padding-top: 10px;
}

.es-agent-section-heading {
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 8px;
    color: rgb(175, 188, 204);
    -unity-font-style: bold;
}

.es-agent-section-heading > Label {
    flex-grow: 1;
}

.es-agent-link-button {
    height: 24px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(63, 196, 221);
    font-size: 11px;
}

.es-agent-link-button:hover {
    color: rgb(142, 233, 247);
    background-color: rgba(47, 191, 218, 0.08);
}

.es-agent-mcp-connect-button {
    height: 24px;
    min-width: 66px;
    margin-right: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: rgb(91, 73, 155);
    border-radius: 4px;
    background-color: rgb(46, 38, 72);
    color: rgb(189, 173, 244);
    font-size: 10px;
    -unity-font-style: bold;
}

.es-agent-mcp-connect-button:hover {
    border-color: rgb(139, 111, 226);
    background-color: rgb(60, 48, 94);
    color: rgb(224, 216, 250);
}

.es-agent-mcp-connect-button.ready {
    border-color: rgb(49, 160, 123);
    background-color: rgb(31, 70, 61);
    color: rgb(137, 224, 190);
}

.es-agent-session-list {
    flex-grow: 1;
    padding-left: 7px;
    padding-right: 7px;
    padding-bottom: 10px;
}

.es-agent-session-row {
    min-height: 54px;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-direction: row;
    align-items: center;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
    background-color: rgba(38, 47, 60, 0.38);
}

.es-agent-session-row:hover {
    background-color: rgb(35, 44, 56);
}

.es-agent-session-row.selected {
    background-color: rgb(38, 50, 64);
    border-left-color: rgb(43, 194, 219);
}

.es-agent-session-main:active {
    background-color: rgba(46, 127, 145, 0.20);
}

.es-agent-session-main {
    min-width: 0;
    min-height: 50px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.es-agent-session-dot {
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 4px;
    background-color: rgb(104, 119, 137);
}

.es-agent-session-dot.running { background-color: rgb(54, 210, 151); }
.es-agent-session-dot.failed { background-color: rgb(226, 85, 88); }
.es-agent-session-dot.completed { background-color: rgb(64, 190, 157); }

.es-agent-session-copy {
    flex-grow: 1;
    min-width: 0;
}

.es-agent-session-title {
    color: rgb(216, 225, 236);
    -unity-font-style: bold;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-session-status {
    margin-top: 3px;
    color: rgb(117, 136, 159);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-icon-button {
    width: 24px;
    min-width: 24px;
    height: 24px;
    margin-right: 2px;
    padding-left: 0;
    padding-right: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(105, 124, 146);
    font-size: 13px;
}

.es-agent-icon-button:hover {
    background-color: rgb(50, 61, 76);
    color: rgb(224, 232, 241);
}

.es-agent-conversation {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(18, 22, 29);
}

.es-agent-conversation-heading {
    height: 54px;
    min-height: 54px;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 48, 61);
}

.es-agent-live-activity {
    min-height: 82px;
    flex-direction: row;
    align-items: center;
    padding: 9px 14px 9px 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 59, 69);
    border-left-width: 3px;
    border-left-color: rgb(53, 191, 216);
    background-color: rgb(20, 31, 39);
}

.es-agent-live-activity.stale {
    border-left-color: rgb(205, 163, 67);
    background-color: rgb(39, 34, 25);
}

.es-agent-live-activity-copy {
    flex-grow: 1;
    min-width: 0;
}

.es-agent-live-activity-caption {
    color: rgb(104, 191, 210);
    font-size: 9px;
    -unity-font-style: bold;
}

.es-agent-live-activity-title {
    margin-top: 2px;
    color: rgb(226, 239, 245);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-live-activity-detail {
    margin-top: 2px;
    color: rgb(173, 199, 209);
    font-size: 10px;
    white-space: normal;
    max-height: 31px;
    overflow: hidden;
}

.es-agent-live-activity-evidence {
    margin-top: 3px;
    color: rgb(109, 139, 154);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-live-activity-actions {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-left: 12px;
}

.es-agent-live-activity-actions > Button {
    margin-left: 5px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.es-agent-navigation-bar {
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 18px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(34, 43, 55);
    background-color: rgb(20, 25, 33);
}

.es-agent-navigation-label {
    flex-grow: 1;
    color: rgb(103, 124, 148);
    font-size: 9px;
    -unity-font-style: bold;
}

.es-agent-navigation-button {
    min-width: 45px;
    height: 23px;
    margin-left: 4px;
    padding-left: 7px;
    padding-right: 7px;
    border-width: 1px;
    border-color: rgb(49, 61, 76);
    border-radius: 4px;
    background-color: rgb(28, 35, 45);
    color: rgb(155, 174, 195);
    font-size: 9px;
}

.es-agent-navigation-button:hover {
    border-color: rgb(53, 165, 188);
    background-color: rgb(34, 47, 59);
    color: rgb(218, 239, 245);
}

.es-agent-heading-copy {
    flex-grow: 1;
    min-width: 0;
}

.es-agent-conversation-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(226, 234, 244);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-conversation-subtitle {
    margin-top: 2px;
    color: rgb(113, 135, 158);
    font-size: 10px;
}

.es-agent-message-list {
    flex-grow: 1;
    min-height: 0;
    padding: 18px;
}

.es-agent-empty {
    max-width: 560px;
    align-self: center;
    align-items: center;
    margin-top: 86px;
    padding: 24px;
}

.es-agent-empty-mark {
    width: 48px;
    height: 48px;
    margin-bottom: 14px;
    border-width: 1px;
    border-color: rgb(50, 191, 216);
    border-radius: 6px;
    background-color: rgba(45, 188, 214, 0.12);
    color: rgb(108, 224, 240);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 15px;
}

.es-agent-empty-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(224, 233, 244);
    -unity-text-align: middle-center;
    white-space: normal;
}

.es-agent-empty-copy {
    margin-top: 9px;
    color: rgb(128, 148, 171);
    -unity-text-align: middle-center;
    white-space: normal;
}

.es-agent-empty-eyebrow {
    margin-bottom: 9px;
    color: rgb(72, 207, 226);
    font-size: 9px;
    -unity-font-style: bold;
}

.es-agent-empty-features {
    margin-top: 18px;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
}

.es-agent-empty-feature {
    margin: 4px;
    padding: 6px 9px;
    border-width: 1px;
    border-color: rgb(47, 72, 86);
    border-radius: 999px;
    background-color: rgba(33, 91, 105, 0.2);
    color: rgb(148, 211, 220);
    font-size: 9px;
}

.es-agent-message-row {
    width: 100%;
    margin-bottom: 14px;
    flex-direction: row;
}

.es-agent-message-row.user { justify-content: flex-end; }
.es-agent-message-row.assistant,
.es-agent-message-row.system,
.es-agent-message-row.error { justify-content: flex-start; }

.es-agent-message-card {
    width: 86%;
    max-width: 860px;
    min-width: 0;
    padding: 12px 14px 13px 14px;
    border-width: 1px;
    border-color: rgb(48, 59, 74);
    border-radius: 6px;
    background-color: rgb(27, 33, 43);
}

.es-agent-message-row.user .es-agent-message-card {
    background-color: rgb(29, 48, 52);
    border-color: rgb(45, 88, 91);
    border-right-width: 2px;
    border-right-color: rgb(57, 190, 170);
}

.es-agent-message-row.assistant .es-agent-message-card {
    border-left-width: 2px;
    border-left-color: rgb(44, 188, 216);
}

.es-agent-message-row.system .es-agent-message-card {
    width: 72%;
    background-color: rgb(32, 37, 45);
    border-left-width: 2px;
    border-left-color: rgb(205, 163, 67);
}

.es-agent-message-row.error .es-agent-message-card {
    background-color: rgb(48, 29, 33);
    border-left-width: 2px;
    border-left-color: rgb(224, 83, 87);
}

.es-agent-message-meta {
    height: 20px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.es-agent-message-badge {
    width: 28px;
    height: 18px;
    margin-right: 7px;
    border-radius: 4px;
    background-color: rgb(44, 188, 216);
    color: rgb(8, 35, 43);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 9px;
}

.es-agent-message-row.user .es-agent-message-badge {
    background-color: rgb(57, 190, 170);
    color: rgb(8, 38, 34);
}

.es-agent-message-row.system .es-agent-message-badge {
    background-color: rgb(205, 163, 67);
    color: rgb(49, 36, 10);
}

.es-agent-message-row.error .es-agent-message-badge {
    background-color: rgb(224, 83, 87);
    color: rgb(53, 15, 17);
}

.es-agent-message-author {
    color: rgb(144, 206, 220);
    -unity-font-style: bold;
    font-size: 10px;
}

.es-agent-message-row.user .es-agent-message-author { color: rgb(111, 218, 183); }
.es-agent-message-row.error .es-agent-message-author { color: rgb(245, 132, 135); }
.es-agent-message-row.system .es-agent-message-author { color: rgb(225, 190, 105); }

.es-agent-message-time {
    flex-grow: 1;
    margin-left: 8px;
    color: rgb(91, 109, 130);
    font-size: 9px;
}

.es-agent-copy-button {
    width: 38px;
    height: 19px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(105, 128, 151);
    font-size: 9px;
}

.es-agent-copy-button:hover { color: rgb(170, 218, 229); }

.es-agent-message-body {
    color: rgb(213, 222, 233);
    font-size: 12px;
    white-space: normal;
}

.es-agent-message-scroll {
    max-height: 300px;
    min-height: 0;
    padding-right: 4px;
    border-left-width: 1px;
    border-left-color: rgba(64, 79, 97, 0.45);
}

.es-agent-message-scroll.user {
    max-height: 230px;
    border-left-color: rgba(67, 190, 169, 0.36);
}

.es-agent-message-scroll.assistant {
    max-height: 390px;
    border-left-color: rgba(61, 190, 216, 0.42);
}

.es-agent-message-scroll.system,
.es-agent-message-scroll.error {
    max-height: 210px;
}

.es-agent-message-scroll.expanded {
    max-height: 720px;
}

.es-agent-message-context {
    margin-top: 9px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgb(52, 63, 77);
    color: rgb(115, 147, 163);
    font-size: 9px;
    white-space: normal;
}

.es-agent-composer-shell {
    min-height: 142px;
    padding: 10px 14px 12px 14px;
    border-top-width: 1px;
    border-top-color: rgb(42, 52, 65);
    background-color: rgb(21, 26, 34);
}

.es-agent-composer {
    flex-grow: 1;
    min-height: 82px;
    max-height: 180px;
}

.es-agent-composer > .unity-text-field__input {
    padding: 10px;
    border-width: 1px;
    border-color: rgb(51, 66, 83);
    border-radius: 6px;
    background-color: rgb(15, 19, 25);
    color: rgb(226, 234, 244);
    white-space: normal;
}

.es-agent-composer > .unity-text-field__input:focus {
    border-color: rgb(48, 187, 214);
}

.es-agent-responsibility-panel {
    min-height: 38px;
    margin-bottom: 6px;
    padding: 5px 7px 5px 8px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgb(48, 61, 76);
    border-radius: 6px;
    background-color: rgb(20, 25, 32);
}

.es-agent-responsibility-panel.attention {
    border-color: rgb(49, 177, 201);
    background-color: rgb(22, 34, 42);
}

.es-agent-responsibility-caption {
    min-width: 32px;
    margin-right: 7px;
    color: rgb(104, 190, 207);
    -unity-font-style: bold;
    font-size: 10px;
}

.es-agent-responsibility-counter {
    min-width: 86px;
    margin-left: 8px;
    color: rgb(101, 119, 140);
    font-size: 9px;
    -unity-text-align: middle-right;
}

.es-agent-responsibility-preset-button {
    width: 94px;
    min-width: 94px;
    height: 27px;
    margin-right: 7px;
    padding-left: 9px;
    padding-right: 7px;
    border-width: 1px;
    border-color: rgb(54, 69, 84);
    border-radius: 4px;
    background-color: rgb(27, 34, 43);
    color: rgb(183, 201, 219);
    -unity-font-style: bold;
    font-size: 10px;
}

.es-agent-responsibility-preset-button:hover {
    border-color: rgb(48, 164, 187);
    background-color: rgb(30, 47, 58);
    color: rgb(211, 239, 245);
}

.es-agent-responsibility-field {
    flex-grow: 1;
    min-width: 120px;
}

.es-agent-responsibility-field > .unity-text-field__input {
    height: 27px;
    border-width: 1px;
    border-color: rgb(48, 61, 76);
    border-radius: 4px;
    background-color: rgb(15, 19, 25);
    color: rgb(211, 222, 235);
}

.es-agent-responsibility-field > .unity-text-field__input:focus {
    border-color: rgb(48, 187, 214);
}

.es-agent-composer.drag-over > .unity-text-field__input {
    border-color: rgb(71, 220, 190);
    background-color: rgb(18, 43, 43);
}

.es-agent-composer-actions {
    min-height: 34px;
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.es-agent-shortcut-hint {
    flex-grow: 1;
    min-width: 160px;
    margin-left: 8px;
    color: rgb(88, 107, 129);
    font-size: 9px;
}

.es-agent-primary-button,
.es-agent-secondary-button {
    min-width: 54px;
    height: 28px;
    margin-left: 5px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 4px;
}

.es-agent-primary-button {
    border-width: 1px;
    border-color: rgb(42, 195, 218);
    background-color: rgb(30, 132, 153);
    color: rgb(239, 252, 254);
    -unity-font-style: bold;
}

.es-agent-primary-button:hover {
    background-color: rgb(36, 157, 180);
}

.es-agent-secondary-button {
    border-width: 1px;
    border-color: rgb(55, 68, 84);
    background-color: rgb(31, 39, 50);
    color: rgb(186, 200, 217);
}

.es-agent-secondary-button:hover {
    border-color: rgb(72, 105, 128);
    background-color: rgb(39, 49, 62);
    color: rgb(226, 235, 245);
}

.es-agent-aiwarnings-button {
    border-color: rgb(121, 94, 46);
    background-color: rgb(48, 41, 29);
    color: rgb(229, 199, 132);
    -unity-font-style: bold;
}

.es-agent-aiwarnings-button:hover {
    border-color: rgb(191, 148, 70);
    background-color: rgb(65, 51, 31);
    color: rgb(255, 224, 158);
}

.es-agent-context-panel {
    width: 286px;
    min-width: 250px;
    flex-shrink: 0;
    padding-top: 10px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(22, 27, 35);
    border-left-width: 1px;
    border-left-color: rgb(43, 52, 66);
}

.es-agent-identity-card {
    margin: 2px 2px 10px 2px;
    padding: 10px;
    border-width: 1px;
    border-color: rgb(46, 111, 126);
    border-left-width: 3px;
    border-left-color: rgb(46, 199, 221);
    border-radius: 8px;
    background-color: rgb(25, 37, 45);
}

.es-agent-identity-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.es-agent-identity-caption {
    flex-grow: 1;
    color: rgb(109, 222, 239);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.es-agent-identity-authority {
    color: rgb(226, 192, 107);
    font-size: 8px;
}

.es-agent-identity-value {
    min-height: 34px;
    padding: 7px;
    border-radius: 4px;
    background-color: rgb(17, 25, 31);
    color: rgb(184, 214, 224);
    font-size: 9px;
    white-space: normal;
}

.es-agent-identity-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 7px;
}

.es-agent-context-list {
    max-height: 230px;
    margin-bottom: 14px;
}

.es-agent-ambient-list {
    margin-bottom: 7px;
}

.es-agent-context-empty {
    margin: 7px 4px 10px 4px;
    padding: 10px;
    border-width: 1px;
    border-color: rgb(46, 55, 68);
    border-radius: 4px;
    color: rgb(96, 115, 137);
    -unity-text-align: middle-center;
}

.es-agent-context-chip {
    min-height: 44px;
    margin: 3px 2px;
    padding-left: 9px;
    flex-direction: row;
    align-items: center;
    border-left-width: 2px;
    border-left-color: rgb(210, 168, 66);
    border-radius: 4px;
    background-color: rgb(34, 39, 46);
}

.es-agent-context-chip.ambient {
    min-height: 40px;
    border-left-color: rgb(48, 187, 214);
    background-color: rgb(27, 38, 46);
}

.es-agent-context-chip.ambient.mcp {
    border-left-color: rgb(132, 104, 231);
    background-color: rgb(32, 30, 49);
}

.es-agent-context-chip.ambient.mcp .es-agent-context-kind {
    color: rgb(177, 157, 245);
}

.es-agent-context-copy {
    flex-grow: 1;
    min-width: 0;
}

.es-agent-context-kind {
    color: rgb(223, 189, 105);
    font-size: 9px;
    -unity-font-style: bold;
}

.es-agent-context-label {
    margin-top: 2px;
    color: rgb(189, 201, 216);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-context-value {
    flex-grow: 1;
    min-width: 0;
    margin-left: 8px;
    color: rgb(113, 151, 166);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-mini-heading-row {
    min-height: 30px;
    flex-direction: row;
    align-items: center;
}

.es-agent-mini-heading-row > .es-agent-mini-heading {
    flex-grow: 1;
}

.es-agent-context-budget {
    margin-right: 4px;
    color: rgb(102, 139, 156);
    font-size: 9px;
}

.es-agent-context-budget.near-limit {
    color: rgb(227, 179, 75);
    -unity-font-style: bold;
}

.es-agent-context-copy-button {
    min-width: 34px;
    height: 22px;
    margin-right: 2px;
    padding-left: 5px;
    padding-right: 5px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(82, 175, 195);
    font-size: 9px;
}

.es-agent-context-copy-button:hover {
    background-color: rgba(47, 191, 218, 0.10);
    color: rgb(148, 230, 244);
}

.es-agent-mini-heading {
    margin-top: 8px;
    margin-bottom: 7px;
    color: rgb(142, 159, 180);
    -unity-font-style: bold;
    font-size: 10px;
    text-transform: uppercase;
}

.es-agent-key-value {
    min-height: 29px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 47, 58);
}

.es-agent-key {
    width: 62px;
    color: rgb(92, 112, 135);
    font-size: 9px;
}

.es-agent-value {
    flex-grow: 1;
    color: rgb(188, 202, 218);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-agent-progress-list {
    max-height: 220px;
    margin-bottom: 12px;
    padding-bottom: 4px;
}

.es-agent-progress-heading {
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.es-agent-progress-heading > .es-agent-mini-heading {
    flex-grow: 1;
    margin-top: 0;
    margin-bottom: 0;
}

.es-agent-progress-heading > .es-agent-navigation-button {
    min-width: 39px;
    margin-left: 3px;
    padding-left: 5px;
    padding-right: 5px;
}

.es-agent-progress-row {
    min-height: 34px;
    margin: 2px 0;
    padding: 6px 7px;
    border-left-width: 2px;
    border-left-color: rgb(49, 176, 200);
    background-color: rgb(27, 37, 45);
}

.es-agent-progress-stage {
    color: rgb(102, 205, 221);
    font-size: 9px;
    -unity-font-style: bold;
}

.es-agent-progress-detail {
    margin-top: 2px;
    color: rgb(178, 196, 211);
    font-size: 9px;
    white-space: normal;
}

.es-agent-inline-actions {
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    margin-top: 8px;
}

.es-agent-settings {
    margin-top: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(46, 56, 69);
}

.es-agent-property {
    margin-top: 3px;
    margin-bottom: 3px;
}

.es-agent-property .unity-base-field__label {
    min-width: 92px;
    color: rgb(126, 144, 164);
}

.es-agent-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 8, 12, 0.82);
}

.es-agent-dialog {
    width: 520px;
    max-height: 620px;
    padding: 20px;
    border-width: 1px;
    border-color: rgb(65, 82, 101);
    border-radius: 6px;
    background-color: rgb(25, 31, 40);
    color: rgb(202, 214, 228);
}

.es-agent-dialog-title {
    margin-bottom: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(231, 239, 248);
}

.es-agent-dialog-input {
    margin-top: 14px;
}

.es-agent-claim-candidate-list {
    max-height: 320px;
    margin-top: 12px;
}

.es-agent-claim-candidate {
    margin-top: 6px;
    padding: 8px;
    border-width: 1px;
    border-color: rgb(55, 70, 87);
    border-radius: 4px;
    background-color: rgb(30, 39, 50);
}

.es-agent-claim-candidate-title {
    color: rgb(219, 231, 242);
    -unity-font-style: bold;
}

.es-agent-claim-candidate-detail {
    margin-top: 3px;
    margin-bottom: 6px;
    color: rgb(159, 178, 196);
    font-size: 10px;
    white-space: normal;
}

.es-agent-resume-item {
    height: 34px;
    margin-top: 3px;
    border-width: 1px;
    border-color: rgb(48, 61, 76);
    border-radius: 4px;
    background-color: rgb(31, 39, 50);
    color: rgb(194, 208, 224);
    -unity-text-align: middle-left;
}

.es-agent-resume-item:hover {
    border-color: rgb(46, 184, 211);
    background-color: rgb(38, 49, 62);
}

.es-agent-root .unity-scroller--horizontal {
    display: none;
}
