/* Extended surface coverage. These selectors cover nested Unity containers
   and ES-owned cards so the visual language remains coherent beyond buttons. */
.es-global-editor-skin .unity-inspector-element__header,
.es-global-editor-skin .unity-base-field__input-container,
.es-global-editor-skin .unity-base-slider,
.es-global-editor-skin .unity-min-max-slider__dragger,
.es-global-editor-skin .unity-toggle__checkmark,
.es-global-editor-skin .unity-foldout__content-container,
.es-global-editor-skin .unity-tab__header,
.es-global-editor-skin .unity-tab-view__header,
.es-global-editor-skin .unity-dropdown-menu,
.es-global-editor-skin .unity-notification,
.es-global-editor-skin .unity-editor-toolbar-element {
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.es-global-editor-skin .es-window-surface,
.es-global-editor-skin .es-window-header,
.es-global-editor-skin .es-window-toolbar,
.es-global-editor-skin .es-window-content,
.es-global-editor-skin .es-window-status,
.es-global-editor-skin .es-dialog-content,
.es-global-editor-skin .es-dialog-body,
.es-global-editor-skin .es-dialog-summary,
.es-global-editor-skin .es-dialog-field,
.es-global-editor-skin .es-dialog-multichoice,
.es-global-editor-skin .es-dialog-recommendation,
.es-global-editor-skin .es-dialog-validation,
.es-global-editor-skin .es-dialog-footer,
.es-global-editor-skin .es-dialog-busy-card {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.es-global-editor-skin .es-dialog-branded .es-dialog-identity-strip {
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.es-global-editor-skin .es-dialog-brand-mark {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-font-style: bold;
}

.es-global-editor-skin .es-dialog-actions,
.es-global-editor-skin .es-dialog-decision-actions,
.es-global-editor-skin .es-window-header-actions {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.es-global-editor-skin .es-dialog-busy-overlay {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* ES-owned content surfaces. These are explicit component contracts, so the
   skin can cover real panels and states without rounding every label or row. */
.es-global-editor-skin .es-window-opening-gate,
.es-global-editor-skin .es-window-opening-gate-content {
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    overflow: hidden;
}

.es-global-editor-skin .es-empty-state,
.es-global-editor-skin .es-error-state,
.es-global-editor-skin .es-panel-section,
.es-global-editor-skin .es-functional-section,
.es-global-editor-skin .es-panel-notice,
.es-global-editor-skin .es-progress-task {
