/* Native controls that are not bound to ES Presentation still receive the
   same restrained geometry when the opt-in deep skin is enabled. Keep the
   radius smaller for rows than for framed surfaces so dense editor lists do
   not turn into a stack of pills. */
.es-global-editor-skin .unity-button,
.es-global-editor-skin .unity-toolbar,
.es-global-editor-skin .unity-toolbar__contents-container,
.es-global-editor-skin .unity-toolbar-button,
.es-global-editor-skin .unity-toolbar-menu,
.es-global-editor-skin .unity-base-field,
.es-global-editor-skin .unity-base-text-field,
.es-global-editor-skin .unity-base-field__input,
.es-global-editor-skin .unity-base-text-field__input,
.es-global-editor-skin .unity-text-input,
.es-global-editor-skin .unity-search-field,
.es-global-editor-skin .unity-search-field__text-input,
.es-global-editor-skin .unity-object-field,
.es-global-editor-skin .unity-object-field__input,
.es-global-editor-skin .unity-base-popup-field,
.es-global-editor-skin .unity-base-popup-field__input,
.es-global-editor-skin .unity-popup-field,
.es-global-editor-skin .unity-popup-field__input,
.es-global-editor-skin .unity-enum-field,
.es-global-editor-skin .unity-tag-field,
.es-global-editor-skin .unity-layer-field,
.es-global-editor-skin .unity-mask-field,
.es-global-editor-skin .unity-slider,
.es-global-editor-skin .unity-min-max-slider,
.es-global-editor-skin .unity-toggle,
.es-global-editor-skin .unity-foldout,
.es-global-editor-skin .unity-toggle__input,
.es-global-editor-skin .unity-foldout__toggle,
.es-global-editor-skin .unity-toolbar__dropdown,
.es-global-editor-skin .unity-toolbar__button,
.es-global-editor-skin .unity-object-field__selector,
.es-global-editor-skin .unity-base-popup-field__arrow,
.es-global-editor-skin .unity-base-slider__tracker,
.es-global-editor-skin .unity-base-slider__dragger,
.es-global-editor-skin .unity-slider__tracker,
.es-global-editor-skin .unity-property-field__input,
.es-global-editor-skin .unity-foldout__content {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.es-global-editor-skin .unity-list-view,
.es-global-editor-skin .unity-tree-view,
.es-global-editor-skin .unity-collection-view,
.es-global-editor-skin .unity-scroll-view,
.es-global-editor-skin .unity-scroll-view__content-viewport,
.es-global-editor-skin .unity-scroll-view__content-container,
.es-global-editor-skin .unity-tab,
.es-global-editor-skin .unity-tab-view__content,
.es-global-editor-skin .unity-tab__content,
.es-global-editor-skin .unity-help-box,
.es-global-editor-skin .unity-box,
.es-global-editor-skin .unity-property-field,
.es-global-editor-skin .unity-inspector-element,
.es-global-editor-skin .unity-two-pane-split-view,
.es-global-editor-skin .unity-two-pane-split-view__content-container,
.es-global-editor-skin .unity-split-view,
.es-global-editor-skin .unity-progress-bar,
.es-global-editor-skin .unity-progress-bar__background,
.es-global-editor-skin .unity-scroller,
.es-global-editor-skin .unity-scroll-view__horizontal-scroller,
.es-global-editor-skin .unity-scroll-view__vertical-scroller {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Secondary surfaces used by inspectors, popups and split workspaces. These
   are deliberately separate from the control radius so nested panels read as
   framed surfaces instead of a row of unrelated pills. */
.es-global-editor-skin .unity-foldout__content,
.es-global-editor-skin .unity-popup-window,
.es-global-editor-skin .unity-dropdown,
.es-global-editor-skin .unity-base-popup-field__input,
.es-global-editor-skin .unity-popup-field__input,
.es-global-editor-skin .unity-scroller__low-button,
.es-global-editor-skin .unity-scroller__high-button,
.es-global-editor-skin .unity-split-view__dragline,
.es-global-editor-skin .unity-two-pane-split-view__dragline,
.es-global-editor-skin #ESWindowShell,
.es-global-editor-skin #ESWindowHeader,
.es-global-editor-skin #ESWindowContent,
.es-global-editor-skin #ESWindowStatusBar {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.es-global-editor-skin .unity-list-view__item,
.es-global-editor-skin .unity-tree-view__item,
.es-global-editor-skin .unity-collection-view__item {
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.es-global-editor-skin .unity-progress-bar__progress,
.es-global-editor-skin .unity-scroller__slider,
.es-global-editor-skin .unity-slider__dragger {
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

.es-global-editor-skin .unity-base-slider__tracker,
.es-global-editor-skin .unity-min-max-slider__tracker,
.es-global-editor-skin .unity-slider__tracker {
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
}

