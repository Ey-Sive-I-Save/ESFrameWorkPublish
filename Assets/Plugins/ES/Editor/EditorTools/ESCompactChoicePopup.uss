.es-compact-choice-root {
    padding: 8px;
    background-color: rgb(18, 23, 30);
}

.es-compact-choice-header {
    min-height: 40px;
    padding-left: 8px;
    padding-right: 6px;
    margin-bottom: 5px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 53, 66);
}

.es-compact-choice-title {
    flex-grow: 1;
    color: rgb(216, 230, 240);
    -unity-font-style: bold;
    font-size: 12px;
}

.es-compact-choice-hint {
    color: rgb(91, 115, 135);
    font-size: 9px;
}

.es-compact-choice-list {
    flex-grow: 1;
}

.es-compact-choice-option {
    min-height: 39px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 10px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    background-color: rgb(24, 31, 40);
}

.es-compact-choice-option:hover,
.es-compact-choice-option:focus {
    border-color: rgb(48, 116, 134);
    background-color: rgb(28, 43, 52);
}

.es-compact-choice-option.selected {
    border-left-width: 3px;
    border-left-color: rgb(47, 194, 220);
    background-color: rgb(25, 42, 51);
}

.es-compact-choice-copy {
    flex-grow: 1;
    min-width: 0;
}

.es-compact-choice-label {
    color: rgb(188, 211, 226);
    -unity-font-style: bold;
    font-size: 10px;
}

.es-compact-choice-subtitle {
    margin-top: 2px;
    color: rgb(103, 128, 148);
    font-size: 9px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.es-compact-choice-badge {
    min-width: 34px;
    height: 19px;
    margin-left: 8px;
    padding-left: 6px;
    padding-right: 6px;
    border-width: 1px;
    border-color: rgb(43, 130, 147);
    border-radius: 999px;
    background-color: rgb(24, 66, 75);
    color: rgb(126, 222, 235);
    font-size: 9px;
    -unity-text-align: middle-center;
}

/* ES dialogs use a dedicated mint-green family in both Unity skin modes. */
.es-compact-choice-dark {
    background-color: rgb(18, 38, 27);
}

.es-compact-choice-dark .es-compact-choice-header {
    border-bottom-color: rgb(66, 111, 77);
}

.es-compact-choice-dark .es-compact-choice-title {
    color: rgb(218, 242, 223);
}

.es-compact-choice-dark .es-compact-choice-hint {
    color: rgb(161, 197, 169);
}

.es-compact-choice-dark .es-compact-choice-option {
    background-color: rgb(25, 49, 34);
}

.es-compact-choice-dark .es-compact-choice-option:hover,
.es-compact-choice-dark .es-compact-choice-option:focus {
    border-color: rgb(78, 153, 96);
    background-color: rgb(35, 70, 47);
}

.es-compact-choice-dark .es-compact-choice-option.selected {
    border-left-color: rgb(99, 199, 119);
    background-color: rgb(31, 76, 45);
}

.es-compact-choice-dark .es-compact-choice-label {
    color: rgb(201, 232, 207);
}

.es-compact-choice-dark .es-compact-choice-subtitle {
    color: rgb(147, 184, 155);
}

.es-compact-choice-dark .es-compact-choice-badge {
    border-color: rgb(76, 151, 91);
    background-color: rgb(30, 82, 48);
    color: rgb(150, 229, 164);
}

.es-compact-choice-light {
    background-color: rgb(230, 246, 234);
}

.es-compact-choice-light .es-compact-choice-header {
    border-bottom-color: rgb(142, 190, 151);
}

.es-compact-choice-light .es-compact-choice-title {
    color: rgb(35, 80, 45);
}

.es-compact-choice-light .es-compact-choice-hint {
    color: rgb(77, 121, 85);
}

.es-compact-choice-light .es-compact-choice-option {
    background-color: rgb(242, 251, 244);
}

.es-compact-choice-light .es-compact-choice-option:hover,
.es-compact-choice-light .es-compact-choice-option:focus {
    border-color: rgb(92, 158, 104);
    background-color: rgb(221, 244, 225);
}

.es-compact-choice-light .es-compact-choice-option.selected {
    border-left-color: rgb(49, 137, 66);
    background-color: rgb(211, 239, 216);
}

.es-compact-choice-light .es-compact-choice-label {
    color: rgb(39, 93, 50);
}

.es-compact-choice-light .es-compact-choice-subtitle {
    color: rgb(88, 130, 95);
}

.es-compact-choice-light .es-compact-choice-badge {
    border-color: rgb(91, 157, 101);
    background-color: rgb(211, 239, 216);
    color: rgb(42, 112, 55);
}
