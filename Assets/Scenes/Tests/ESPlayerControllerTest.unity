    - local-control
    - main-camera
  - id: vault
    title: "移动、跳跃与翻越"
    landmark: {fileID: 1533193057}
    routeColor: {r: 0.42, g: 0.9, b: 0.65, a: 1}
    objective: "前往右前方低墙，完成移动、跳跃和翻越。"
    expectedResult: "KCC 运动连续；翻越结束后角色重新回到地面状态。"
    failureHint: "检查 KCC、ClimbableSurface、输入调度与玩家状态包。"
    inputActions: 000000001400000019000000
    checkIds:
