    landmark: {fileID: 524386648}
    routeColor: {r: 1, g: 0.72, b: 0.3, a: 1}
    objective: "前往正前方攀爬墙，完成附着、上行与翻上平台。"
    expectedResult: "攀爬状态进入与退出正确，翻上后落在后方平台。"
    failureHint: "检查攀爬层、墙体标记、状态支持标记与 KCC 运动顺序。"
    inputActions: 000000001400000019000000
    checkIds:
