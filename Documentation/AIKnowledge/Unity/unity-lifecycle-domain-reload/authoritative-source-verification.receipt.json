  "verifiedClaims": [
    {
      "claimId": "lifecycle-awake-onenable-start",
      "sourceId": "unity-manual-execution-order",
      "verbatimExcerpt": "Awake: First lifecycle function called when a new instance of an object is created. Always called before any Start functions. If a GameObject is inactive during start up, Awake is not called until it is made active."
    },
    {
      "claimId": "lifecycle-cross-object-order",
      "sourceId": "unity-manual-execution-order",
      "verbatimExcerpt": "Awake is only guaranteed to be called before OnEnable in the scope of each individual object. Across multiple objects the order is not deterministic and you can’t rely on one object’s Awake being called before another object’s OnEnable."
    },
    {
      "claimId": "lifecycle-use-start-after-scene-awake",
      "sourceId": "unity-manual-execution-order",
      "verbatimExcerpt": "Any work that depends on Awake having been called for all objects in the scene should be done in Start."
    },
    {
      "claimId": "domain-reload-default-reset",
      "sourceId": "unity-manual-domain-reloading",
      "verbatimExcerpt": "Domain Reloading resets your scripting state, and is enabled by default. It provides you with a completely fresh scripting state, and resets all static fields and registered handlers each time you enter Play Mode."
    },
    {
      "claimId": "domain-reload-disabled-static-state",
      "sourceId": "unity-manual-domain-reloading",
      "verbatimExcerpt": "When Domain Reloading is disabled, the values of static fields in your code do not automatically reset to their original values. You need to add code that explicitly does this."
    },
    {
      "claimId": "domain-reload-subsystem-registration",
      "sourceId": "unity-manual-domain-reloading",
      "verbatimExcerpt": "For runtime scripts, you must use the [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)] attribute to reset static fields and event handlers."
    },
    {
      "claimId": "enter-play-mode-two-actions",
      "sourceId": "unity-manual-configurable-enter-play-mode",
      "verbatimExcerpt": "It resets the scripting state (this is also called a “Domain Reload”) It reloads the Scene"
    },
    {
      "claimId": "scene-reload-callbacks",
      "sourceId": "unity-manual-scene-reloading",
      "verbatimExcerpt": "Unity still calls the same initialization functions (such as OnEnable, OnDisable and OnDestroy) as if it were freshly loaded."
    },
    {
      "claimId": "script-order-per-event-category",
      "sourceId": "unity-manual-script-execution-order",
      "verbatimExcerpt": "The order applies to each category of event function separately"
    },
    {
      "claimId": "runtime-initialization-not-orderable",
      "sourceId": "unity-manual-script-execution-order",
      "verbatimExcerpt": "The execution order specified in this settings window does not affect the order of functions marked with the RuntimeInitializeOnLoadMethod attribute. (You cannot specify an order for runtime initialization.)"
    },
    {
      "claimId": "default-execution-order-api",
      "sourceId": "unity-core-api-xml",
      "verbatimExcerpt": "Specifies the script execution order for a MonoBehaviour-derived class relative to other MonoBehaviour-derived types."
    },
    {
      "claimId": "subsystem-registration-api",
      "sourceId": "unity-core-api-xml",
      "verbatimExcerpt": "Callback invoked when starting up the runtime. Called before the first scene is loaded."
    },
    {
      "claimId": "disable-domain-reload-api",
      "sourceId": "unity-editor-api-xml",
      "verbatimExcerpt": "When Domain Reload is disabled, scripts are not reloaded when entering Play Mode."
    },
