{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/abcd/adaptive-learning/v1",
  "title": "ES ABCD Adaptive Learning v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "recordType"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/abcd/adaptive-learning/v1" },
    "recordType": { "enum": ["ABCDDatasetPartitionManifest", "ABCDAdaptiveLearningPlan", "ABCDPolicyCandidate", "ABCDPolicyEvaluation", "ABCDAdaptiveLearningReceipt", "ABCDHoldoutGate"] },
    "datasetId": { "$ref": "#/$defs/id" },
    "manifestHash": { "$ref": "#/$defs/hash" },
    "partitions": { "type": "object", "additionalProperties": false, "required": ["train", "validation", "holdout"], "properties": { "train": { "$ref": "#/$defs/cases" }, "validation": { "$ref": "#/$defs/cases" }, "holdout": { "$ref": "#/$defs/cases" } } },
    "partitionHashes": { "type": "object", "additionalProperties": false, "required": ["train", "validation", "holdout"], "properties": { "train": { "$ref": "#/$defs/hash" }, "validation": { "$ref": "#/$defs/hash" }, "holdout": { "$ref": "#/$defs/hash" } } },
    "isolationPolicy": { "const": "case-snapshot-source-group-disjoint" },
    "planId": { "type": "string", "pattern": "^abcd-alp-[a-f0-9]{32}$" },
    "planHash": { "$ref": "#/$defs/hash" },
    "datasetRef": { "type": "object", "additionalProperties": false, "required": ["datasetId", "manifestHash", "trainHash", "validationHash", "holdoutHash"], "properties": { "datasetId": { "$ref": "#/$defs/id" }, "manifestHash": { "$ref": "#/$defs/hash" }, "trainHash": { "$ref": "#/$defs/hash" }, "validationHash": { "$ref": "#/$defs/hash" }, "holdoutHash": { "$ref": "#/$defs/hash" } } },
    "generatorId": { "$ref": "#/$defs/id" }, "fixedSeed": { "type": "string", "minLength": 1 }, "trainerId": { "$ref": "#/$defs/id" },
    "metricDefinitions": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/metricDefinition" } },
    "budgets": { "$ref": "#/$defs/budgets" }, "promotionAllowed": { "const": false },
    "candidateId": { "type": "string", "pattern": "^abcd-pc-[a-f0-9]{32}$" }, "status": { "const": "candidate" }, "roundNo": { "type": "integer", "minimum": 1 }, "candidateNo": { "type": "integer", "minimum": 1 }, "planRef": { "type": "object", "additionalProperties": false, "required": ["planId", "planHash"], "properties": { "planId": { "$ref": "#/$defs/id" }, "planHash": { "$ref": "#/$defs/hash" } } }, "basePolicyRef": { "$ref": "#/$defs/policyRef" }, "parentCandidateRef": { "oneOf": [{ "$ref": "#/$defs/parentRef" }, { "type": "null" }] }, "generatedBy": { "$ref": "#/$defs/id" }, "fixedSeedHash": { "$ref": "#/$defs/hash" }, "trainingDataRef": { "type": "object", "additionalProperties": false, "required": ["partition", "partitionHash"], "properties": { "partition": { "const": "train" }, "partitionHash": { "$ref": "#/$defs/hash" } } }, "mutation": { "type": "object", "additionalProperties": false, "required": ["kind", "mutationHash"], "properties": { "kind": { "enum": ["weight-adjustment", "route-policy", "threshold", "selection-rule"] }, "mutationHash": { "$ref": "#/$defs/hash" } } }, "candidateHash": { "$ref": "#/$defs/hash" }, "promotion": { "$ref": "#/$defs/promotion" }, "nonClaims": { "$ref": "#/$defs/nonClaims" },
    "evaluationId": { "type": "string", "pattern": "^abcd-ale-[a-f0-9]{32}$" }, "candidateRef": { "$ref": "#/$defs/candidateRef" }, "evaluator": { "$ref": "#/$defs/actor" }, "auditor": { "$ref": "#/$defs/actor" }, "caseCount": { "type": "integer", "minimum": 1 }, "metricCallCount": { "type": "integer", "minimum": 1 }, "metricDeltas": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/delta" } }, "regressions": { "type": "array", "items": { "type": "string" } }, "improvements": { "type": "array", "items": { "type": "string" } }, "noRegressionPassed": { "type": "boolean" }, "paretoEligible": { "type": "boolean" }, "decision": { "enum": ["pareto-candidate", "rejected", "await-explicit-review", "no-safe-candidate", "continue-within-budget"] }, "evaluationHash": { "$ref": "#/$defs/hash" },
    "runId": { "type": "string", "pattern": "^abcd-alr-[a-f0-9]{32}$" }, "candidateCount": { "type": "integer", "minimum": 0 }, "evaluationCount": { "type": "integer", "minimum": 0 }, "paretoFrontier": { "type": "array", "items": { "$ref": "#/$defs/frontier" } }, "roundScores": { "type": "array" }, "convergence": { "type": "object", "additionalProperties": false, "required": ["converged", "window", "minImprovement", "ownsTaskCompletion"], "properties": { "converged": { "type": "boolean" }, "window": { "type": "integer", "minimum": 2 }, "minImprovement": { "type": "number", "minimum": 0 }, "ownsTaskCompletion": { "const": false } } }, "decision": { "enum": ["no-safe-candidate", "await-explicit-review", "continue-within-budget"] }, "promotion": { "$ref": "#/$defs/promotion" }, "receiptHash": { "$ref": "#/$defs/hash" },
    "gateId": { "type": "string", "pattern": "^abcd-alh-[a-f0-9]{32}$" }, "gateInvocationNo": { "const": 1 }, "selectionRef": { "type": "object", "additionalProperties": false, "required": ["runId", "receiptHash"], "properties": { "runId": { "$ref": "#/$defs/id" }, "receiptHash": { "$ref": "#/$defs/hash" } } }, "holdoutGateRef": { "$ref": "#/$defs/id" }, "gateHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["caseId", "sourceGroupId", "snapshotHash"], "properties": { "caseId": { "$ref": "#/$defs/id" }, "sourceGroupId": { "$ref": "#/$defs/id" }, "snapshotHash": { "$ref": "#/$defs/hash" } } } },
    "metricDefinition": { "type": "object", "additionalProperties": false, "required": ["name", "direction", "minDelta", "noRegressionTolerance"], "properties": { "name": { "type": "string", "minLength": 1 }, "direction": { "enum": ["maximize", "minimize"] }, "minDelta": { "type": "number", "minimum": 0 }, "noRegressionTolerance": { "type": "number", "minimum": 0 } } },
    "budgets": { "type": "object", "additionalProperties": false, "required": ["maxRounds", "maxCandidates", "maxEvaluations", "maxMetricCalls", "maxCases", "convergenceWindow"], "properties": { "maxRounds": { "type": "integer", "minimum": 1 }, "maxCandidates": { "type": "integer", "minimum": 1 }, "maxEvaluations": { "type": "integer", "minimum": 1 }, "maxMetricCalls": { "type": "integer", "minimum": 1 }, "maxCases": { "type": "integer", "minimum": 1 }, "convergenceWindow": { "type": "integer", "minimum": 2 } } },
    "policyRef": { "type": "object", "additionalProperties": false, "required": ["policyId", "policyHash"], "properties": { "policyId": { "$ref": "#/$defs/id" }, "policyHash": { "$ref": "#/$defs/hash" } } }, "parentRef": { "type": "object", "additionalProperties": false, "required": ["candidateId", "candidateHash", "roundNo"], "properties": { "candidateId": { "type": "string", "pattern": "^abcd-pc-[a-f0-9]{32}$" }, "candidateHash": { "$ref": "#/$defs/hash" }, "roundNo": { "type": "integer", "minimum": 1 } } }, "promotion": { "type": "object", "additionalProperties": false, "required": ["promotionAllowed", "requiresExplicitApply"], "properties": { "promotionAllowed": { "const": false }, "requiresExplicitApply": { "const": true }, "decision": { "type": "string" } } }, "nonClaims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "candidateRef": { "type": "object", "additionalProperties": false, "required": ["candidateId", "candidateHash", "roundNo"], "properties": { "candidateId": { "type": "string", "pattern": "^abcd-pc-[a-f0-9]{32}$" }, "candidateHash": { "$ref": "#/$defs/hash" }, "roundNo": { "type": "integer", "minimum": 1 } } }, "actor": { "type": "object", "additionalProperties": false, "required": ["authorizationProof"], "properties": { "evaluatorId": { "$ref": "#/$defs/id" }, "auditorId": { "$ref": "#/$defs/id" }, "authorizationProof": { "type": "string", "minLength": 1 } } }, "delta": { "type": "object", "additionalProperties": false, "required": ["partition", "name", "direction", "baseline", "candidate", "signedDelta", "minDelta", "tolerance"], "properties": { "partition": { "enum": ["validation", "holdout"] }, "name": { "type": "string" }, "direction": { "enum": ["maximize", "minimize"] }, "baseline": { "type": "number" }, "candidate": { "type": "number" }, "signedDelta": { "type": "number" }, "minDelta": { "type": "number", "minimum": 0 }, "tolerance": { "type": "number", "minimum": 0 } } }, "frontier": { "type": "object", "additionalProperties": false, "required": ["candidateId", "candidateHash", "evaluationId", "evaluationHash"], "properties": { "candidateId": { "$ref": "#/$defs/id" }, "candidateHash": { "$ref": "#/$defs/hash" }, "evaluationId": { "$ref": "#/$defs/id" }, "evaluationHash": { "$ref": "#/$defs/hash" } } }
  }
}
