{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/abcd/self-iteration/v1",
  "title": "ES ABCD Self Iteration Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "recordType", "iterationId", "taskId", "taskBindingRef", "routePlanHash", "sourceScopeHash", "plan", "planHash", "rounds", "usedRounds", "usedAttempts", "status", "stoppedReason", "nextAction", "eventCount", "eventHashes", "learningCandidates", "nonClaims", "resultHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/abcd/self-iteration/v1" },
    "recordType": { "const": "ABCDSelfIterationReceipt" },
    "iterationId": { "type": "string", "pattern": "^si-[a-f0-9]{32}$" },
    "taskId": { "$ref": "#/$defs/id" },
    "taskBindingRef": { "$ref": "#/$defs/bindingRef" },
    "routePlanHash": { "$ref": "#/$defs/hash" },
    "sourceScopeHash": { "$ref": "#/$defs/hash" },
    "plan": { "$ref": "#/$defs/plan" },
    "planHash": { "$ref": "#/$defs/hash" },
    "rounds": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/round" } },
    "usedRounds": { "type": "integer", "minimum": 0 },
    "usedAttempts": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["not-started", "stopped", "review", "budget-exhausted", "completed"] },
    "stoppedReason": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "nextAction": { "enum": ["retry-same-plan", "create-new-plan", "await-collaborator-choice", "stop-and-report"] },
    "eventCount": { "type": "integer", "minimum": 0 },
    "eventHashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "learningCandidates": { "type": "array", "items": { "$ref": "#/$defs/learningCandidate" } },
    "nonClaims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "resultHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectPath": { "type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$" },
    "bindingRef": {
      "type": "object", "additionalProperties": false, "required": ["bindingId", "bindingHash"],
      "properties": { "bindingId": { "$ref": "#/$defs/id" }, "bindingHash": { "$ref": "#/$defs/hash" } }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "failureClass", "decision", "maxRounds", "attemptsPerRound", "maxTotalAttempts", "maxCandidatesPerRound", "candidateHints", "decisionMap", "failureClasses"],
      "properties": {
        "seed": { "type": "string", "minLength": 1, "maxLength": 256 },
        "failureClass": { "enum": ["input", "source", "route", "capability", "environment", "evidence"] },
        "decision": { "enum": ["retry", "replan", "branch", "stop"] },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 256 },
        "attemptsPerRound": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxTotalAttempts": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxCandidatesPerRound": { "type": "integer", "minimum": 1, "maximum": 16 },
        "candidateHints": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "decisionMap": {
          "type": "object", "additionalProperties": false, "required": ["retry", "replan", "branch", "stop"],
          "properties": {
            "retry": { "const": "retry-same-plan" },
            "replan": { "const": "create-new-plan" },
            "branch": { "const": "await-collaborator-choice" },
            "stop": { "const": "stop-and-report" }
          }
        },
        "failureClasses": { "type": "array", "const": ["input", "source", "route", "capability", "environment", "evidence"] }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["branchId", "parentBranchId", "snapshotHash", "changedAssumption", "verificationPredicate", "generationIndex", "generationHash"],
      "properties": {
        "branchId": { "$ref": "#/$defs/id" },
        "parentBranchId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "snapshotHash": { "$ref": "#/$defs/hash" },
        "changedAssumption": { "type": "string", "minLength": 1 },
        "verificationPredicate": { "type": "string", "minLength": 1 },
        "generationIndex": { "type": "integer", "minimum": 0 },
        "generationHash": { "$ref": "#/$defs/hash" },
        "generationMode": { "enum": ["creative-divergence", "engineering", "stable"] },
        "innovationAxis": { "type": "string", "minLength": 1 },
        "hidden": { "const": false },
        "pruningPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["branchId", "auditorRef", "verifierRef", "verifierDefinitionHash", "authorizationProof", "verdict", "evidenceRefs", "structuralChecks", "auditHash"],
      "properties": {
        "branchId": { "$ref": "#/$defs/id" },
        "auditorRef": { "$ref": "#/$defs/id" },
        "verifierRef": { "$ref": "#/$defs/id" },
        "verifierDefinitionHash": { "$ref": "#/$defs/hash" },
        "authorizationProof": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["pass", "fail", "review"] },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "structuralChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "auditHash": { "$ref": "#/$defs/hash" },
        "evaluatedChecks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "predicateResult": { "enum": ["passed", "unproven"] }
      }
    },
    "round": {
      "type": "object", "additionalProperties": false, "required": ["roundNo", "attemptNo", "candidateProposals", "auditProposals", "selectedBranchId", "cycleId", "verificationStatus", "verificationReceiptRef", "nextAction", "controllerStatus", "advanced", "learningCandidateIds"],
      "properties": {
        "roundNo": { "type": "integer", "minimum": 1 },
        "attemptNo": { "const": 1 },
        "candidateProposals": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/candidate" } },
        "auditProposals": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/audit" } },
        "selectedBranchId": { "$ref": "#/$defs/id" },
        "cycleId": { "$ref": "#/$defs/id" },
        "verificationStatus": { "enum": ["passed", "failed", "review"] },
        "verificationReceiptRef": { "oneOf": [{ "type": "string", "pattern": "^receipt-[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" }, { "type": "null" }] },
        "nextAction": { "enum": ["retry-same-plan", "create-new-plan", "await-collaborator-choice", "stop-and-report"] },
        "controllerStatus": { "enum": ["advanced", "review", "stopped"] },
        "advanced": { "type": "boolean" },
        "learningCandidateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^abcd-lc-[a-f0-9]{32}$" } }
      }
    },
    "sourceRef": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "role"],
      "properties": { "path": { "$ref": "#/$defs/projectPath" }, "sha256": { "$ref": "#/$defs/hash" }, "role": { "enum": ["finding", "verification", "contract", "required-read", "evidence"] } }
    },
    "learningCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contractId", "recordType", "candidateId", "status", "taskId", "cycleId", "attemptNo", "taskBindingRef", "routePlanHash", "sourceScopeHash", "findingReceiptRef", "verificationReceiptRef", "failureClass", "decision", "sourceRefs", "knowledgeTarget", "validation", "candidateHash", "nonClaims"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractId": { "const": "es://automation/contracts/abcd/learning-candidate/v1" },
        "recordType": { "const": "ABCDLearningCandidate" },
        "candidateId": { "type": "string", "pattern": "^abcd-lc-[a-f0-9]{32}$" },
        "status": { "enum": ["candidate", "review", "validated", "stale", "rejected"] },
        "taskId": { "$ref": "#/$defs/id" },
        "cycleId": { "$ref": "#/$defs/id" },
        "attemptNo": { "type": "integer", "minimum": 1 },
        "taskBindingRef": { "$ref": "#/$defs/bindingRef" },
        "routePlanHash": { "$ref": "#/$defs/hash" },
        "sourceScopeHash": { "$ref": "#/$defs/hash" },
        "findingReceiptRef": { "type": "string", "minLength": 1 },
        "verificationReceiptRef": { "type": "string", "pattern": "^receipt-[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
        "failureClass": { "enum": ["input", "source", "route", "capability", "environment", "evidence"] },
        "decision": { "enum": ["retry", "replan", "branch", "stop"] },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } },
        "knowledgeTarget": {
          "type": "object", "additionalProperties": false, "required": ["knowledgeId", "targetPath", "routeKeys"],
          "properties": { "knowledgeId": { "$ref": "#/$defs/id" }, "targetPath": { "$ref": "#/$defs/projectPath" }, "routeKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,80}$" } } }
        },
        "validation": {
          "type": "object", "additionalProperties": false, "required": ["state", "verifierId", "verifierDefinitionHash", "sourceStableAtEnd", "promotionAllowed"],
          "properties": { "state": { "enum": ["pending", "passed", "review", "failed", "stale"] }, "verifierId": { "$ref": "#/$defs/id" }, "verifierDefinitionHash": { "$ref": "#/$defs/hash" }, "sourceStableAtEnd": { "type": "boolean" }, "promotionAllowed": { "const": false } }
        },
        "candidateHash": { "$ref": "#/$defs/hash" },
        "nonClaims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
