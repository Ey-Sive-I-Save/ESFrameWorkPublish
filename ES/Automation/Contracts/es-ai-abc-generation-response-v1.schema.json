{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/ai-abc/generation-response/v1",
  "title": "ES AI ABC Generation Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "generationMode", "status", "candidates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/ai-abc/generation-response/v1" },
    "generationMode": { "enum": ["creative-divergence", "engineering", "stable"] },
    "status": { "const": "candidate" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "resourceBudget": {
      "const": {
        "maxResponseCharacters": 128000,
        "maxTotalProposedChangeCharacters": 64000,
        "maxTotalProposedChangeFiles": 32,
        "materializeOnlySelectedCandidate": true
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "mechanism", "playerValue", "playerDelightScore", "modeScores", "amplificationChain", "selfCritique", "selfCritiquePasses", "seedDraft", "expansionSet", "auditFindings", "playabilityBackpressure", "finalDecision", "deletedAnchors", "novelMechanism", "plausibilityRationale", "counterplayInvariant", "surpriseScore", "plausibilityScore", "firstUseAffordance", "partialUnderstandingPath", "masteryDepth", "onboardingBurden", "firstPayoffSeconds", "firstInputCount", "preservedIdentity", "preservedRole", "requestedFormFactor", "formFactorPreserved", "mechanismDelta", "concretePlayerScenario", "inputSequence", "visibleFeedback", "acceptabilityRationale", "concretenessScore", "acceptabilityScore", "iterationTrace", "lineageRoot", "lineageDepth", "risks", "counterplay", "validationMetric"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "playerValue": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "playerDelightScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "modeScores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delight", "smoothness", "presentation", "skillCeiling", "joyLoop", "first10sMoment", "expressionCeiling", "noveltyDelta", "counterplayClarity", "depth", "breakthrough", "reusability", "longevity", "projectFit", "completeness", "safety", "closure"],
          "properties": {
            "delight": { "type": "integer", "minimum": 0, "maximum": 100 },
            "smoothness": { "type": "integer", "minimum": 0, "maximum": 100 },
            "presentation": { "type": "integer", "minimum": 0, "maximum": 100 },
            "skillCeiling": { "type": "integer", "minimum": 0, "maximum": 100 },
            "joyLoop": { "type": "integer", "minimum": 0, "maximum": 100 },
            "first10sMoment": { "type": "integer", "minimum": 0, "maximum": 100 },
            "expressionCeiling": { "type": "integer", "minimum": 0, "maximum": 100 },
            "noveltyDelta": { "type": "integer", "minimum": 0, "maximum": 100 },
            "counterplayClarity": { "type": "integer", "minimum": 0, "maximum": 100 },
            "depth": { "type": "integer", "minimum": 0, "maximum": 100 },
            "breakthrough": { "type": "integer", "minimum": 0, "maximum": 100 },
            "reusability": { "type": "integer", "minimum": 0, "maximum": 100 },
            "longevity": { "type": "integer", "minimum": 0, "maximum": 100 },
            "projectFit": { "type": "integer", "minimum": 0, "maximum": 100 },
            "completeness": { "type": "integer", "minimum": 0, "maximum": 100 },
            "safety": { "type": "integer", "minimum": 0, "maximum": 100 },
            "closure": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "amplificationChain": { "type": "string", "description": "At least four distinct stages: core action, linked mechanic, visible payoff, and recovery/follow-up choice.", "minLength": 32, "maxLength": 12000 },
        "selfCritique": { "type": "string", "description": "Visible self-critique and repair summary: weakest dimension, concrete amplification/repair, and post-repair ranking rationale.", "minLength": 32, "maxLength": 8000 },
        "selfCritiquePasses": { "type": "integer", "minimum": 2, "maximum": 4 },
        "seedDraft": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "expansionSet": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "auditFindings": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "playabilityBackpressure": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "finalDecision": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "deletedAnchors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "novelMechanism": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "plausibilityRationale": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "counterplayInvariant": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "surpriseScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "plausibilityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "firstUseAffordance": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "partialUnderstandingPath": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "masteryDepth": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "onboardingBurden": { "type": "integer", "minimum": 0, "maximum": 100 },
        "firstPayoffSeconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "firstInputCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "preservedIdentity": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "preservedRole": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "requestedFormFactor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "formFactorPreserved": { "type": "boolean" },
        "mechanismDelta": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "concretePlayerScenario": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "inputSequence": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "visibleFeedback": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "acceptabilityRationale": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "concretenessScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "iterationTrace": { "type": "array", "minItems": 12, "items": { "type": "object", "required": ["roundId", "parentCandidateId", "branchId", "branchReason", "concreteChange", "playerAcceptability", "keepOrDiscardReason", "decision"], "properties": { "roundId": { "type": "integer", "minimum": 1 }, "parentCandidateId": { "type": "string", "minLength": 1 }, "branchId": { "type": "string", "minLength": 1 }, "branchReason": { "type": "string", "minLength": 1 }, "concreteChange": { "type": "string", "minLength": 1 }, "playerAcceptability": { "type": "integer", "minimum": 0, "maximum": 100 }, "keepOrDiscardReason": { "type": "string", "minLength": 1 }, "decision": { "enum": ["keep", "discard"] } } } },
        "lineageRoot": { "type": "string", "minLength": 1 },
        "lineageDepth": { "type": "integer", "minimum": 12 },
        "acceptabilityScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "risks": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "counterplay": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "validationMetric": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "hidden": { "const": false },
        "status": { "const": "candidate" },
        "proposedChanges": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "changeId", "afterContent"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[/\\])\\.\\.(?:[/\\]|$)).+" },
              "changeId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "afterContent": { "type": "string", "maxLength": 2000000 }
            }
          }
        }
      }
    }
  }
}
