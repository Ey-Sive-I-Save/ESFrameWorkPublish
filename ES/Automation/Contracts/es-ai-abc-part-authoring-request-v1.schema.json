{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/ai-abc/part-authoring-request/v1",
  "title": "ES AI ABC Part Authoring Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "partId", "domain", "capabilityRefs", "aProfile", "bProfile", "cProfile", "aToBMappings", "routePlanTemplate"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "partId": { "type": "string", "pattern": "^es\\.[a-z0-9-]+\\.abc\\.part\\.v[0-9]+$" },
    "domain": { "const": "weapon" },
    "capabilityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" } },
    "aProfile": {
      "type": "object", "additionalProperties": false, "required": ["responsibility", "intentKinds"],
      "properties": {
        "responsibility": { "type": "string", "minLength": 1 },
        "intentKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "bProfile": {
      "type": "object", "additionalProperties": false, "required": ["responsibility", "providers"],
      "properties": {
        "responsibility": { "type": "string", "minLength": 1 },
        "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "cProfile": {
      "type": "object", "additionalProperties": false, "required": ["collaboratorKinds", "acceptanceInputs"],
      "properties": {
        "collaboratorKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["human", "ai"] } },
        "acceptanceInputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "aToBMappings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["intentId", "bCapability", "input", "output"],
        "properties": {
          "intentId": { "type": "string", "minLength": 1 },
          "bCapability": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
          "input": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routePlanTemplate": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["stage", "requires", "produces"],
        "properties": {
          "stage": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
          "requires": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "produces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "evidenceProfile": {
      "type": "object", "additionalProperties": false, "required": ["required", "runtimeClaimsNotProven"],
      "properties": {
        "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "runtimeClaimsNotProven": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
