{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/ai-abc/part/v1",
  "title": "ES AI ABC Part Contract V1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "partId", "mode", "domain", "coreRef", "capabilityRefs", "aProfile", "bProfile", "cProfile", "routePlanTemplate", "evidenceProfile", "compatibility", "fallback"],
    "properties": {
      "schemaVersion": { "const": 1 }, "contractId": { "const": "es://automation/contracts/ai-abc/part/v1" }, "partId": { "type": "string", "pattern": "^es\\.[a-z0-9-]+\\.abc\\.part\\.v[0-9]+$" }, "mode": { "const": "ABCP.Part" }, "domain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }, "coreRef": { "const": "es.ai-abc.core.v1" }, "coreContractRef": { "const": "ES/Automation/Contracts/es-ai-abc-core-v1.json" }, "capabilityRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" } }, "aProfile": { "type": "object", "required": ["responsibility", "intentKinds"], "additionalProperties": false, "properties": { "responsibility": { "type": "string", "minLength": 1 }, "intentKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }, "bProfile": { "type": "object", "required": ["responsibility", "providers"], "additionalProperties": false, "properties": { "responsibility": { "type": "string", "minLength": 1 }, "providers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }, "cProfile": { "type": "object", "required": ["collaboratorKinds", "acceptanceInputs"], "additionalProperties": false, "properties": { "collaboratorKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["human", "ai"] } }, "acceptanceInputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }, "aToBMappings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["intentId", "bCapability", "input", "output"], "additionalProperties": false, "properties": { "intentId": { "type": "string", "minLength": 1 }, "bCapability": { "type": "string", "minLength": 1 }, "input": { "type": "string", "minLength": 1 }, "output": { "type": "string", "minLength": 1 } } } }, "routePlanTemplate": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["stage", "requires", "produces"], "additionalProperties": false, "properties": { "stage": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" }, "requires": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "produces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } } }, "evidenceProfile": { "type": "object", "required": ["required", "runtimeClaimsNotProven"], "additionalProperties": false, "properties": { "required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "runtimeClaimsNotProven": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }, "compatibility": { "type": "object", "required": ["canonicalAuthority", "dualTrackAllowed", "noSilentMerge"], "additionalProperties": false, "properties": { "canonicalAuthority": { "const": "part" }, "dualTrackAllowed": { "type": "boolean" }, "noSilentMerge": { "type": "boolean", "const": true }, "legacyAdapter": { "type": "string", "minLength": 1 } } }, "fallback": { "type": "object", "required": ["mode", "fallbackContractId", "explicitOnly"], "additionalProperties": false, "properties": { "mode": { "const": "ABCD.Dynamic" }, "fallbackContractId": { "const": "es.ai-abc.dynamic-fallback.v1" }, "explicitOnly": { "const": true } } }
  }
}
