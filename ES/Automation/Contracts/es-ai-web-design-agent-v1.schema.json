{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/ai-web-design-agent/v1",
  "title": "ES AI Web Design-and-Code Agent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "taskId", "requirementSnapshot", "upstreamRounds", "round05DesignPacket", "abcdDecision", "allowedWriteRoots", "requiredReads", "requiredChecks", "maxIterations", "stopConditions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"const": "AiWebDesignTask"},
    "taskId": {"type": "string", "minLength": 1},
    "requirementSnapshot": {"type": "object", "minProperties": 1},
    "upstreamRounds": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["round", "path", "hash", "role"], "properties": {"round": {"type": "integer", "minimum": 1, "maximum": 5}, "path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "role": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "round05DesignPacket": {"type": "object", "required": ["path", "hash"], "properties": {"path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": true},
    "abcdDecision": {"type": "object", "required": ["invocationId", "selectedCandidateId", "decision"], "properties": {"invocationId": {"type": "string", "minLength": 1}, "selectedCandidateId": {"type": "string", "minLength": 1}, "decision": {"enum": ["candidate", "revise"]}}, "additionalProperties": true},
    "allowedWriteRoots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requiredReads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requiredChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "maxIterations": {"type": "integer", "minimum": 1, "maximum": 24},
    "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
