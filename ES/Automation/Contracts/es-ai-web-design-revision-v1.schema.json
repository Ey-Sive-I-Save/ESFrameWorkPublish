{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/ai-web-design-revision/v1",
  "title": "ES AI Web Design Revision Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "taskId", "round", "reads", "writes", "designDecision", "implementationSummary", "changedFiles", "changedRegions", "failureCauses", "nextHypotheses", "sourceHashBefore", "sourceHashAfter", "requestedChecks", "artifactPath", "status"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"const": "AiWebDesignRevisionReceipt"},
    "taskId": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1},
    "reads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "writes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "designDecision": {"type": "string", "minLength": 20},
    "implementationSummary": {"type": "string", "minLength": 20},
    "changedFiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "changedRegions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failureCauses": {"type": "array", "items": {"type": "string"}},
    "nextHypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sourceHashBefore": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "sourceHashAfter": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "requestedChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "artifactPath": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "revision", "blocked"]}
  }
}
