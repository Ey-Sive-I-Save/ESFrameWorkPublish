{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/ai-web-solution-response/v1",
  "title": "ES AI Web Page Solution Response Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "providerRunId", "intent", "capabilityMap", "informationArchitecture", "interactionDesign", "visualDesign", "responsiveAndStates", "dataAndAcceptance", "aiAnalysis", "execution", "returnReceipt", "evidence", "provenance", "upstreamRounds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"const": "AiWebSolutionResponse"},
    "providerRunId": {"type": "string", "minLength": 8, "not": {"pattern": "(?i)normalized-|synthetic|fixture"}},
    "intent": {"type": "string", "minLength": 80},
    "capabilityMap": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["capability", "userValue", "evidence"], "properties": {"capability": {"type": "string", "minLength": 1}, "userValue": {"type": "string", "minLength": 20}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "informationArchitecture": {"type": "string", "minLength": 120},
    "interactionDesign": {"type": "string", "minLength": 120},
    "visualDesign": {"type": "string", "minLength": 120},
    "responsiveAndStates": {"type": "string", "minLength": 80},
    "dataAndAcceptance": {"type": "string", "minLength": 80},
    "aiAnalysis": {"type": "string", "minLength": 80},
    "execution": {"type": "string", "minLength": 40},
    "returnReceipt": {"type": "object", "required": ["status", "observable"], "properties": {"status": {"type": "string", "minLength": 1}, "observable": {"type": "boolean"}}, "additionalProperties": true},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind", "pathOrRef", "hash"], "properties": {"kind": {"type": "string", "minLength": 1}, "pathOrRef": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}, "additionalProperties": true}},
    "provenance": {"type": "object", "required": ["actor"], "properties": {"actor": {"enum": ["current-ai-session", "provider"]}}, "additionalProperties": true},
    "upstreamRounds": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["round", "path", "hash", "role"], "properties": {"round": {"type": "integer", "minimum": 1, "maximum": 5}, "path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, "role": {"type": "string", "minLength": 1}}, "additionalProperties": true}}
  }
}
