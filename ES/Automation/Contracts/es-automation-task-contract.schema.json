{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/task-contract/v1",
  "title": "ESAutomationCenter Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "taskId", "version", "worker", "inputs", "readRoots", "writeRoots", "capabilities", "timeoutSeconds", "supportsDryRun", "outputs"],
  "properties": {
    "protocolVersion": { "type": "integer", "const": 1 },
    "taskId": { "type": "string", "pattern": "^es\\.[a-z0-9]+(?:\\.[a-z0-9-]+)+$" },
    "version": { "type": "integer", "minimum": 1 },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "workerId", "version", "entrypointHash"],
      "properties": {
        "type": { "type": "string", "enum": ["Python", "PowerShell", "DotNet", "Other"] },
        "workerId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "entrypointHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "readRoots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "writeRoots": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["ReadArtifacts", "WriteReports", "WriteTemp", "WriteAssets", "Delete", "Upload", "Publish", "ExternalRead", "ExternalWrite", "MaterializeUI"] }
    },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
    "supportsDryRun": { "type": "boolean" },
    "supportsRetry": { "type": "boolean", "default": false },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputSchemaHash": { "anyOf": [ { "const": "" }, { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } ] },
    "performanceBudget": {
      "anyOf": [ { "type": "null" }, {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationSeconds", "maxOutputBytes", "maxRetryCount", "maxFindingCount"],
      "properties": {
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 },
        "maxRetryCount": { "type": "integer", "minimum": 0 },
        "maxFindingCount": { "type": "integer", "minimum": 0 }
      } } ]
    },
    "acceptanceCriteria": {
      "anyOf": [ { "type": "null" }, {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "criteria"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "authorityDomain": { "type": "string", "enum": ["", "ai-collaboration", "game-logic", "editor-tooling", "release"] },
        "authorityRiskClass": { "type": "string", "enum": ["", "standard", "high", "critical"] },
        "freshnessPolicy": {
          "anyOf": [ { "type": "null" }, {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAgeHours", "requireSourceHash", "allowRuntimeNotRun"],
          "properties": {
            "maxAgeHours": { "type": "integer", "minimum": 1, "maximum": 8760 },
            "requireSourceHash": { "type": "boolean" },
            "allowRuntimeNotRun": { "type": "boolean" },
            "requireExecutionSnapshotBinding": { "type": "boolean", "default": false }
          },
          "allOf": [
            {
              "if": { "properties": { "requireExecutionSnapshotBinding": { "const": true } } },
              "then": { "properties": { "requireSourceHash": { "const": true } } }
            }
          ] } ]
        },
        "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceCriterion" } }
      } } ]
    },
    "capabilityEnvelope": {
      "anyOf": [ { "type": "null" }, {
      "type": "object",
      "additionalProperties": false,
      "required": ["userAuthorization", "taskContract", "aiCommand", "workerCapability", "projectBoundary"],
      "properties": {
        "userAuthorization": { "type": "integer", "minimum": 0 },
        "taskContract": { "type": "integer", "minimum": 0 },
        "aiCommand": { "type": "integer", "minimum": 0 },
        "workerCapability": { "type": "integer", "minimum": 0 },
        "projectBoundary": { "type": "integer", "minimum": 0 }
      } } ]
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "verifierId", "description", "required", "runtimeRequired", "forbiddenConditions"],
      "properties": {
        "criterionId": { "type": "string", "minLength": 1 },
        "verifierId": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "required": { "type": "boolean" },
        "runtimeRequired": { "type": "boolean" },
        "forbiddenConditions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
