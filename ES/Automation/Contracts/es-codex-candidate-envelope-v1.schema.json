{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/codex/candidate-envelope/v1",
  "schemaVersion": 1,
  "title": "ES Codex CandidateEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractId", "providerId", "threadId", "turnId", "runId", "taskId",
    "taskVersion", "planHash", "sourceScopeHash", "currentHead", "candidateSetHash",
    "generationMode", "status", "claimLevel", "canApply", "finalAuthority", "effects",
    "evidenceRefs", "failureCodes", "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/codex/candidate-envelope/v1" },
    "providerId": { "const": "es-codex" },
    "threadId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" },
    "sessionId": { "type": "string", "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]*$" },
    "turnId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "taskId": { "const": "es.codex.app-server" },
    "taskVersion": { "const": 1 },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceScopeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidateSetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generationMode": { "enum": ["creative-divergence", "engineering", "stable"] },
    "status": { "const": "candidate" },
    "claimLevel": { "const": "candidate-only" },
    "canApply": { "const": false },
    "finalAuthority": { "const": "ABCD-audit-only" },
    "effects": { "$ref": "#/$defs/effects" },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "failureCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writesAllowed", "runtimeAllowed", "gitAllowed", "releaseAllowed"],
      "properties": {
        "writesAllowed": { "const": false },
        "runtimeAllowed": { "const": false },
        "gitAllowed": { "const": false },
        "releaseAllowed": { "const": false }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentHead", "planHash", "sourceScopeHash", "candidateSetHash",
        "requiresCurrentHeadRecheck", "requiresAbcdAudit", "requiresExplicitApply"
      ],
      "properties": {
        "currentHead": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceScopeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidateSetHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "requiresCurrentHeadRecheck": { "const": true },
        "requiresAbcdAudit": { "const": true },
        "requiresExplicitApply": { "const": true }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeId", "beforeHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "changeId": { "type": "string", "minLength": 1 },
        "beforeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId", "candidateType", "changedFiles", "preconditions", "effects", "proposedChanges",
        "evidenceRefs", "failureCodes", "claimLevel", "canApply", "candidate"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "candidateType": { "const": "abc-generation" },
        "changedFiles": { "type": "array", "items": { "$ref": "#/$defs/changedFile" } },
        "preconditions": { "$ref": "#/$defs/preconditions" },
        "effects": { "$ref": "#/$defs/effects" },
        "proposedChanges": { "type": "array", "items": { "$ref": "#/$defs/proposedChange" } },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "failureCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "claimLevel": { "const": "candidate-only" },
        "canApply": { "const": false },
        "candidate": { "type": "object", "additionalProperties": true }
      }
    },
    "proposedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeId", "afterContent"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "changeId": { "type": "string", "minLength": 1 },
        "afterContent": { "type": "string", "maxLength": 2000000 }
      }
    }
  }
}
