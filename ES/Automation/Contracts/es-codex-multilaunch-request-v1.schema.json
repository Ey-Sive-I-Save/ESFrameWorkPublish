{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/codex-multilaunch-request/v1",
  "title": "ES Codex MultiLaunch AITalk Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["batchId", "launches", "maxParallel", "dryRun"],
  "properties": {
    "batchId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 16 },
    "dryRun": { "type": "boolean" },
    "reissue": { "type": "boolean", "default": false },
    "launches": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["taskKey", "responsibilityKey", "tabTitle", "taskPrompt", "mode"],
        "properties": {
          "taskKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "responsibilityKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "tabTitle": { "type": "string", "minLength": 1, "maxLength": 120 },
          "taskPrompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "mode": { "type": "string", "enum": ["New", "Handoff", "Reissue"] },
          "sessionPath": { "type": "string", "minLength": 1 },
          "archivePath": { "type": "string", "minLength": 1 },
          "existingEnvelopePath": { "type": "string" },
          "existingLaunchToken": { "type": "string" }
        }
      }
    }
  }
}
