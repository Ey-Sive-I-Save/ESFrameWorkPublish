{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/commercial-evaluation/v1",
  "title": "ES Commercial Evaluation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "contractHash", "recordType", "reportId", "registryId", "registryHash", "scope", "generatedUtc", "minimumStableRuns", "taskCount", "evaluatedTaskCount", "sourceSnapshotHash", "taskObservations", "metrics", "overallStatus", "nonClaims", "reportHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/commercial-evaluation/v1" },
    "contractHash": { "$ref": "#/$defs/hash" },
    "recordType": { "const": "CommercialEvaluationReport" },
    "reportId": { "type": "string", "pattern": "^commercial-[a-f0-9]{32}$" },
    "registryId": { "const": "es.ai-collaboration.commercial-metrics.v1" },
    "registryHash": { "$ref": "#/$defs/hash" },
    "scope": { "const": "task-cohort" },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "minimumStableRuns": { "type": "integer", "minimum": 2, "maximum": 100 },
    "taskCount": { "type": "integer", "minimum": 1 },
    "evaluatedTaskCount": { "type": "integer", "minimum": 0 },
    "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
    "taskObservations": { "type": "array", "items": { "$ref": "#/$defs/taskObservation" } },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metricResult" } },
    "overallStatus": { "enum": ["closed", "partial"] },
    "nonClaims": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reportHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,80}$" },
    "nullableId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "nullableDecision": { "oneOf": [{ "enum": ["accepted", "rejected", "undetermined"] }, { "type": "null" }] },
    "nullableNumber": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
    "nullableInteger": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
    "taskObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "recordType", "scope", "taskId", "goalRevisionHash", "profileId", "taskRevision", "contextVersion", "taskStatus", "contextStatus", "latestDecision", "latestEvaluationId", "evaluationCount", "firstEventUtc", "lastObservedUtc", "evaluationLatencyMs", "hardViolationObserved", "hardViolationCodes", "recoveryEligible", "recoveryObserved", "regressionObserved", "regressionPassed", "regressionClaimCount", "regressionFailureCount", "correctionObservationClosed", "humanCorrectionObserved", "correctionCount", "sourceSnapshotHash", "observationHash"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "recordType": { "const": "CommercialTaskObservation" },
        "scope": { "const": "task-object" },
        "taskId": { "$ref": "#/$defs/id" },
        "goalRevisionHash": { "$ref": "#/$defs/hash" },
        "profileId": { "$ref": "#/$defs/id" },
        "taskRevision": { "type": "integer", "minimum": 1 },
        "contextVersion": { "type": "integer", "minimum": 1 },
        "taskStatus": { "type": "string", "minLength": 1 },
        "contextStatus": { "type": "string", "minLength": 1 },
        "latestDecision": { "$ref": "#/$defs/nullableDecision" },
        "latestEvaluationId": { "$ref": "#/$defs/nullableId" },
        "evaluationCount": { "type": "integer", "minimum": 0 },
        "firstEventUtc": { "type": "string", "format": "date-time" },
        "lastObservedUtc": { "type": "string", "format": "date-time" },
        "evaluationLatencyMs": { "$ref": "#/$defs/nullableInteger" },
        "hardViolationObserved": { "type": "boolean" },
        "hardViolationCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]{2,127}$" } },
        "recoveryEligible": { "type": "boolean" },
        "recoveryObserved": { "type": "boolean" },
        "regressionObserved": { "type": "boolean" },
        "regressionPassed": { "type": "boolean" },
        "regressionClaimCount": { "type": "integer", "minimum": 0 },
        "regressionFailureCount": { "type": "integer", "minimum": 0 },
        "correctionObservationClosed": { "type": "boolean" },
        "humanCorrectionObserved": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "correctionCount": { "$ref": "#/$defs/nullableInteger" },
        "sourceSnapshotHash": { "$ref": "#/$defs/hash" },
        "observationHash": { "$ref": "#/$defs/hash" }
      }
    },
    "metricResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metricId", "state", "value", "numerator", "denominator", "coverageCount", "unit", "sourceAuthority", "scope", "reason"],
      "properties": {
        "metricId": { "enum": ["successRate", "stableSuccessRate", "hardViolationRate", "claimOverstatementRate", "humanCorrectionRate", "meanLatency", "meanCost", "recoveryRate", "regressionPassRate"] },
        "state": { "enum": ["closed", "evidence-pending"] },
        "value": { "$ref": "#/$defs/nullableNumber" },
        "numerator": { "$ref": "#/$defs/nullableInteger" },
        "denominator": { "$ref": "#/$defs/nullableInteger" },
        "coverageCount": { "type": "integer", "minimum": 0 },
        "unit": { "enum": ["ratio", "milliseconds", "cost-units"] },
        "sourceAuthority": { "enum": ["TaskContextRuntime", "registered-external-verifier"] },
        "scope": { "const": "task-cohort" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
