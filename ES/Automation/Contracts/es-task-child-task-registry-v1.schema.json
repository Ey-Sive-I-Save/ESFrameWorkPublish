{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/task-collaboration/child-registry/v1",
  "title": "ES Child Task Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "registryId", "parentTaskId", "parentTaskRevision", "collaborationPlanId", "collaborationPlanHash", "registryRevision", "children", "registryHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/task-collaboration/child-registry/v1" },
    "registryId": { "type": "string", "pattern": "^ctr-[a-f0-9]{32}$" },
    "parentTaskId": { "$ref": "#/$defs/id" },
    "parentTaskRevision": { "type": "integer", "minimum": 1 },
    "collaborationPlanId": { "type": "string", "pattern": "^cplan-[a-f0-9]{32}$" },
    "collaborationPlanHash": { "$ref": "#/$defs/hash" },
    "registryRevision": { "type": "integer", "minimum": 1 },
    "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/child" } },
    "registryHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": ["childTaskId", "ordinal"],
      "properties": {
        "childTaskId": { "$ref": "#/$defs/id" },
        "ordinal": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
