{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"esframework://automation/contracts/web/cache-policy/v1",
  "title":"ES Web Route Cache Policy",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","recordType","policyId","routes","invalidation","evidence","nonClaims"],
  "properties":{
    "schemaVersion":{"const":1},"recordType":{"const":"WebPageStudioCachePolicy"},"policyId":{"type":"string","pattern":"^[a-z][a-z0-9._-]{2,127}$"},
    "routes":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["routeId","renderPolicy","cacheControl","keyStrategy","fallback"],"properties":{
      "routeId":{"type":"string","pattern":"^[a-z][a-z0-9._/-]{1,127}$"},"renderPolicy":{"enum":["prerender","cached","dynamic","client-only"]},
      "cacheControl":{"type":"object","additionalProperties":false,"required":["maxAgeSeconds","staleWhileRevalidateSeconds","staleIfErrorSeconds","private"],"properties":{"maxAgeSeconds":{"type":"integer","minimum":0},"staleWhileRevalidateSeconds":{"type":"integer","minimum":0},"staleIfErrorSeconds":{"type":"integer","minimum":0},"private":{"type":"boolean"}}},
      "keyStrategy":{"enum":["immutable-hash","etag-version","request-fingerprint","none"]},"invalidationTags":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-z0-9._:-]{1,127}$"}},"fallback":{"enum":["last-known-good","shell-only","error-state","none"]}
    }}},
    "invalidation":{"type":"object","additionalProperties":false,"required":["mode","versionSource","onMutation","recovery"],"properties":{"mode":{"enum":["tagged","versioned","manual"]},"versionSource":{"type":"string","minLength":1},"onMutation":{"enum":["purge","revalidate","mark-stale","deny"]},"recovery":{"enum":["serve-stale","shell-only","error-state","block"]}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["status","runtimeStatus","sourceHash"],"properties":{"status":{"enum":["designed","static-verified","runtime-verified","review"]},"runtimeStatus":{"enum":["runtime-not-run","runtime-passed","runtime-failed"]},"sourceHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "nonClaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
