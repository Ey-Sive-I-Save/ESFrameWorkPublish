{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "esframework://automation/contracts/web-page-studio-backend/v1",
  "title": "ES WebPageStudio Backend Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "contractId", "mode", "adapter", "network", "retry", "cancellation", "redaction", "operationPolicy", "execution", "nonClaims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "WebPageStudioBackendContract" },
    "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
    "mode": { "enum": ["mock-contract-only", "local-adapter", "user-authorized-service"] },
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["adapterId", "version", "executionKind"],
      "properties": {
        "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "executionKind": { "enum": ["contract-only", "local-process", "remote-http"] }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "apiBase", "allowlist", "timeoutSeconds", "maxResponseBytes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "apiBase": { "type": "string" },
        "allowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._*:-]{0,254}$" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "maxResponseBytes": { "type": "integer", "minimum": 1024, "maximum": 104857600 }
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "maxAttempts", "backoffSeconds", "maxBackoffSeconds", "retryableStatusCodes", "idempotentOnly"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 5 },
        "backoffSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
        "maxBackoffSeconds": { "type": "number", "minimum": 0, "maximum": 300 },
        "retryableStatusCodes": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 408, "maximum": 599 } },
        "idempotentOnly": { "type": "boolean" }
      }
    },
    "cancellation": {
      "type": "object", "additionalProperties": false,
      "required": ["supported", "cancelOnTimeout", "graceSeconds", "checkpointPolicy"],
      "properties": {
        "supported": { "const": true },
        "cancelOnTimeout": { "const": true },
        "graceSeconds": { "type": "integer", "minimum": 0, "maximum": 30 },
        "checkpointPolicy": { "enum": ["before-request", "before-each-retry", "before-response", "all"] }
      }
    },
    "redaction": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "replacement", "fieldNames", "headerNames", "queryParameters"],
      "properties": {
        "enabled": { "const": true },
        "replacement": { "type": "string", "minLength": 1, "maxLength": 64 },
        "fieldNames": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" } },
        "headerNames": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,127}$" } },
        "queryParameters": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$" } }
      }
    },
    "operationPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["readOnly", "allowedMethods", "deniedMethods"],
      "properties": {
        "readOnly": { "const": true },
        "allowedMethods": { "type": "array", "minItems": 1, "items": { "enum": ["GET", "HEAD"] } },
        "deniedMethods": { "type": "array", "minItems": 1, "items": { "enum": ["POST", "PUT", "PATCH", "DELETE", "CONNECT", "TRACE"] } }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "networkCalls", "runtimeStatus"],
      "properties": {
        "status": { "const": "not-run" },
        "networkCalls": { "const": 0 },
        "runtimeStatus": { "const": "runtime-not-run" }
      }
    },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
