{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"esframework://automation/contracts/web/release-acceptance-receipt/v1",
  "title":"ES Web Release Acceptance Receipt",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","recordType","receiptId","status","staging","budgets","metrics","artifact","rollback","cacheUpdate","runtimeStatus","nonClaims"],
  "properties":{
    "schemaVersion":{"const":1},"recordType":{"const":"WebPageStudioReleaseAcceptanceReceipt"},"receiptId":{"type":"string","pattern":"^[a-z][a-z0-9._-]{1,127}$"},"status":{"enum":["accepted","review","blocked","not-run"]},
    "staging":{"type":"object","additionalProperties":false,"required":["url","https","deploymentId","checkedUtc"],"properties":{"url":{"type":"string","pattern":"^https://"},"https":{"const":true},"deploymentId":{"type":"string","minLength":1},"checkedUtc":{"type":"string","format":"date-time"}}},
    "budgets":{"type":"object","additionalProperties":false,"required":["lcpMs","inpMs","cls","jsBytes","fontBytes","imageBytes"],"properties":{"lcpMs":{"type":"integer","minimum":1},"inpMs":{"type":"integer","minimum":1},"cls":{"type":"number","minimum":0},"jsBytes":{"type":"integer","minimum":0},"fontBytes":{"type":"integer","minimum":0},"imageBytes":{"type":"integer","minimum":0},"budgetConfigHash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "metrics":{"type":"object","additionalProperties":false,"required":["lcpMs","inpMs","cls","p75","lighthouseScores"],"properties":{"lcpMs":{"type":"integer","minimum":0},"inpMs":{"type":"integer","minimum":0},"cls":{"type":"number","minimum":0},"p75":{"const":true},"lighthouseScores":{"type":"object","additionalProperties":{"type":"integer","minimum":0,"maximum":100}}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["manifestPath","artifactHash","rollbackPoint"],"properties":{"manifestPath":{"type":"string","minLength":1},"artifactHash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"rollbackPoint":{"type":"string","minLength":1}}},
    "rollback":{"type":"object","additionalProperties":false,"required":["tested","procedure","owner"],"properties":{"tested":{"type":"boolean"},"procedure":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1}}},
    "cacheUpdate":{"type":"object","additionalProperties":false,"required":["strategy","purgeRequested","purgeObserved","versionKey"],"properties":{"strategy":{"enum":["immutable-hash","purge-and-revalidate","service-worker-versioned"]},"purgeRequested":{"type":"boolean"},"purgeObserved":{"type":"boolean"},"versionKey":{"type":"string","minLength":1}}},
    "runtimeStatus":{"enum":["runtime-passed","runtime-failed","runtime-not-run"]},"nonClaims":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
