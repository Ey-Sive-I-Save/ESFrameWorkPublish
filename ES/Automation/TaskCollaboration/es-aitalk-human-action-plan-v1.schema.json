{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/task-collaboration/aitalk-human-action-plan/v1",
  "title": "ES AITalk Human Action Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "recordType", "status", "humanActionRequired", "projectAggregationHash", "actionItems", "autoActions", "completionDecisionRequired", "nonClaims", "planHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/task-collaboration/aitalk-human-action-plan/v1" },
    "recordType": { "const": "AITalkHumanActionPlan" },
    "status": { "enum": ["auto-ready", "needs-human-decision", "interrupted"] },
    "humanActionRequired": { "type": "boolean" },
    "projectAggregationHash": { "$ref": "#/$defs/hash" },
    "roundGateStatus": { "type": ["string", "null"] },
    "actionItems": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "autoActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "completionDecisionRequired": { "const": true },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "planHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity", "summary"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_:-]{1,80}$" },
        "severity": { "enum": ["info", "review", "decision"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
