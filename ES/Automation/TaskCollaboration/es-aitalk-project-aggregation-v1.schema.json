{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/task-collaboration/aitalk-project-aggregation/v1",
  "title": "ES AITalk Project Aggregation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "recordType", "projectAggregationId", "sessionsRoot", "status", "sessions", "sessionCount", "discoveredSessionCount", "sessionLimitReached", "resourceLimits", "messageCount", "completionDecisionRequired", "nonClaims", "aggregationHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/task-collaboration/aitalk-project-aggregation/v1" },
    "recordType": { "const": "AITalkProjectAggregation" },
    "projectAggregationId": { "type": "string", "pattern": "^aitalk-project-[a-f0-9]{32}$" },
    "sessionsRoot": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "partial", "conflict", "needs-review"] },
    "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } },
    "sessionCount": { "type": "integer", "minimum": 0 },
    "discoveredSessionCount": { "type": "integer", "minimum": 0 },
    "sessionLimitReached": { "type": "boolean" },
    "resourceLimits": {
      "type": "object", "additionalProperties": false, "required": ["maxSessions", "maxMessagesPerSession", "maxMessageBytes"],
      "properties": {
        "maxSessions": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxMessagesPerSession": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "maxMessageBytes": { "type": "integer", "minimum": 1024, "maximum": 4194304 }
      }
    },
    "messageCount": { "type": "integer", "minimum": 0 },
    "completionDecisionRequired": { "const": true },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "aggregationHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "sessionPath", "status", "messageCount", "quarantineCount", "aggregationHash"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "sessionPath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["candidate", "partial", "conflict", "needs-review"] },
        "messageCount": { "type": "integer", "minimum": 0 },
        "quarantineCount": { "type": "integer", "minimum": 0 },
        "latestMessageUtc": { "type": ["string", "null"] },
        "hasConsensusFile": { "type": "boolean" },
        "aggregationHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
