{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "es://automation/contracts/task-collaboration/aitalk-round-gate/v1",
  "title": "ES AITalk Round Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "status", "maxRounds", "observedRounds", "lastRound", "stopRound", "stopReason", "completionDecisionRequired", "nonClaims", "gateHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "es://automation/contracts/task-collaboration/aitalk-round-gate/v1" },
    "status": { "enum": ["continue", "consensus-reached", "needs-user-decision", "interrupted"] },
    "maxRounds": { "const": 5 },
    "observedRounds": { "type": "array", "items": { "$ref": "#/$defs/round" } },
    "lastRound": { "type": "integer", "minimum": 0, "maximum": 5 },
    "stopRound": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "stopReason": { "type": ["string", "null"] },
    "completionDecisionRequired": { "const": true },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "gateHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "round": {
      "type": "object", "additionalProperties": false,
      "required": ["round", "consensusReached", "userDecisionRequired"],
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 5 },
        "consensusReached": { "type": "boolean" },
        "userDecisionRequired": { "type": "boolean" },
        "newMessageCount": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    }
  }
}
