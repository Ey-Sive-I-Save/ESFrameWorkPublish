Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
function Get-EvidenceHash($v){$sha=[Security.Cryptography.SHA256]::Create();try{([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes(($v|ConvertTo-Json -Depth 40 -Compress)))).Replace('-','').ToLowerInvariant())}finally{$sha.Dispose()}}
function New-ESAdapterEvidenceSet { param([Parameter(Mandatory)][string]$TaskId,[Parameter(Mandatory)][string]$AdapterId,[Parameter(Mandatory)][string]$AdapterVersion,[Parameter(Mandatory)]$Observation,[string]$SourceScopeHash='') $base=[ordered]@{schemaVersion=1;evidenceSetId='EAS-'+([guid]::NewGuid().ToString('N'));taskId=$TaskId;adapterId=$AdapterId;adapterVersion=$AdapterVersion;capturedUtc=[DateTime]::UtcNow.ToString('o');sourceScopeHash=$SourceScopeHash;observationHash=Get-EvidenceHash $Observation;items=@([ordered]@{claimId="adapter.$AdapterId";outcome='passed';verifier='es-adapter-replay';observation=$Observation});contradictions=@();unverifiedClaims=@('External framework runtime equivalence')};$base.evidenceSetHash=Get-EvidenceHash $base;[pscustomobject]$base }
function New-ESAdapterReceipt { param([Parameter(Mandatory)]$Evidence,[Parameter(Mandatory)][string]$Decision,[string]$IdempotencyKey='') if($Decision-notin @('accepted','review','rejected')){throw 'invalid decision'};$base=[ordered]@{schemaVersion=1;receiptType='ESAdapterEvidenceReceipt';receiptId='EAR-'+([guid]::NewGuid().ToString('N'));taskId=$Evidence.taskId;adapterId=$Evidence.adapterId;adapterVersion=$Evidence.adapterVersion;evidenceSetHash=$Evidence.evidenceSetHash;decision=$Decision;idempotencyKey=$IdempotencyKey;issuedUtc=[DateTime]::UtcNow.ToString('o')};$base.receiptHash=Get-EvidenceHash $base;[pscustomobject]$base }
function Test-ESAdapterEvidence { param([Parameter(Mandatory)]$Evidence) $base=[ordered]@{};foreach($p in $Evidence.PSObject.Properties){if($p.Name-ne'evidenceSetHash'){$base[$p.Name]=$p.Value}};if((Get-EvidenceHash $base)-cne[string]$Evidence.evidenceSetHash){throw 'evidence-set-hash-mismatch'};[pscustomobject]@{status='passed';evidenceSetHash=$Evidence.evidenceSetHash} }
function ConvertTo-ESPlatformEvidenceInput { param([Parameter(Mandatory)]$AdapterEvidence,[Parameter(Mandatory)][string]$TaskId,[Parameter(Mandatory)][string]$SourceScopeHash,[Parameter(Mandatory)][string]$ClaimId) if([string]$AdapterEvidence.taskId-cne$TaskId){throw 'adapter task mismatch'};if($SourceScopeHash-notmatch'^[a-f0-9]{64}$'){throw 'invalid source scope hash'};$contractPath=Join-Path $PSScriptRoot '..\Contracts\es-platform-evidence-v1.schema.json';$contractHash=(Get-FileHash -LiteralPath $contractPath -Algorithm SHA256).Hash.ToLowerInvariant();$now=[DateTime]::UtcNow.ToString('o');$item=[ordered]@{claimId=$ClaimId;outcome='unverified';candidateOutcome='unverified';capturedUtc=$now;sourceScopeHash=$SourceScopeHash;evidenceHash=[string]$AdapterEvidence.evidenceSetHash;candidateEvidenceHash=[string]$AdapterEvidence.observationHash;producerType='unverified';candidateProducerType='adapter';verificationStatus='unverified';verifierId=$null;verifierDefinitionHash=$null;artifactHash=[string]$AdapterEvidence.observationHash;artifactPath=$null};$base=[ordered]@{schemaVersion=1;contractId='es://automation/contracts/platform-evidence/v1';contractHash=$contractHash;recordType='EvidenceSet';inputContractMode='canonical-v1';taskId=$TaskId;evidenceSetId=[string]$AdapterEvidence.evidenceSetId;capturedUtc=$now;items=@([pscustomobject]$item);contradictions=@();sourceDrift=@();unverifiedClaims=@($ClaimId)};$base.evidenceSetHash=Get-EvidenceHash $base;[pscustomobject]$base }
function Submit-ESAdapterEvidenceToTaskContext { param([Parameter(Mandatory)][string]$ProjectRoot,[string]$StoreRoot='ES/Output/TaskContextRuntime',[Parameter(Mandatory)][string]$TaskId,[Parameter(Mandatory)]$AdapterEvidence,[Parameter(Mandatory)][string]$SourceScopeHash,[Parameter(Mandatory)][string]$ClaimId,[Parameter(Mandatory)][int]$ExpectedTaskRevision,[Parameter(Mandatory)][int]$ExpectedContextVersion,[Parameter(Mandatory)][string]$IdempotencyKey)
 $runtime=Join-Path $PSScriptRoot '..\TaskContextRuntime\ESTaskContextRuntime.psm1';Import-Module (Resolve-Path $runtime).Path -Force;$contractPath=Join-Path $PSScriptRoot '..\Contracts\es-platform-evidence-v1.schema.json';$contractHash=(Get-FileHash -LiteralPath $contractPath -Algorithm SHA256).Hash.ToLowerInvariant();$dir=Join-Path (Join-Path $ProjectRoot $StoreRoot) $TaskId;if(-not(Test-Path -LiteralPath $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null};$name='adapter-evidence-'+$AdapterEvidence.evidenceSetId+'.json';$relative=(Join-Path $StoreRoot (Join-Path $TaskId $name)).Replace('\','/');$artifact=[ordered]@{schemaVersion=1;claimId=$ClaimId;sourceScopeHash=$SourceScopeHash;adapterId=[string]$AdapterEvidence.adapterId;adapterVersion=[string]$AdapterEvidence.adapterVersion;observationHash=[string]$AdapterEvidence.observationHash;observation=$AdapterEvidence.items[0].observation};$full=Join-Path $dir $name;if(Test-Path -LiteralPath $full){$existing=Get-Content -Raw -Encoding UTF8 $full|ConvertFrom-Json;if((Get-EvidenceHash $existing)-ne(Get-EvidenceHash $artifact)){throw 'existing adapter evidence content differs'}}else{[IO.File]::WriteAllText($full,($artifact|ConvertTo-Json -Depth 40),[Text.UTF8Encoding]::new($false))};$artifactHash=(Get-FileHash -LiteralPath $full -Algorithm SHA256).Hash.ToLowerInvariant();$captured=[DateTime]::UtcNow.ToString('o');$input=[ordered]@{schemaVersion=1;contractId='es://automation/contracts/platform-evidence/v1';contractHash=$contractHash;recordType='CandidateEvidenceSet';taskId=$TaskId;evidenceSetId=[string]$AdapterEvidence.evidenceSetId;capturedUtc=$captured;items=@([ordered]@{claimId=$ClaimId;candidateOutcome='passed';capturedUtc=$captured;sourceScopeHash=$SourceScopeHash;candidateEvidenceHash=$artifactHash;candidateProducerType='adapter';artifactPath=$relative});contradictions=@();sourceDrift=@();unverifiedClaims=@()};$candidateName='adapter-candidate-'+$AdapterEvidence.evidenceSetId+'.json';$candidateFull=Join-Path $dir $candidateName;[IO.File]::WriteAllText($candidateFull,($input|ConvertTo-Json -Depth 30),[Text.UTF8Encoding]::new($false));$candidateRelative=(Join-Path $StoreRoot (Join-Path $TaskId $candidateName)).Replace('\','/');Submit-ESTaskEvidenceSet -ProjectRoot $ProjectRoot -StoreRoot $StoreRoot -TaskId $TaskId -EvidenceSetPath $candidateRelative -ExpectedTaskRevision $ExpectedTaskRevision -ExpectedContextVersion $ExpectedContextVersion -IdempotencyKey $IdempotencyKey }
function Invoke-ESAdapterObservationVerifier { param([Parameter(Mandatory)]$Observation,[Parameter(Mandatory)][string]$AdapterId,[Parameter(Mandatory)][string]$AdapterVersion) if($null-eq$Observation){throw 'observation-missing'};if([string]::IsNullOrWhiteSpace($AdapterId)-or[string]::IsNullOrWhiteSpace($AdapterVersion)){throw 'adapter-identity-missing'};[pscustomobject]@{verifierId='es-adapter-observation-v1';adapterId=$AdapterId;adapterVersion=$AdapterVersion;outcome='passed';observationHash=Get-EvidenceHash $Observation;verifiedUtc=[DateTime]::UtcNow.ToString('o')} }
Export-ModuleMember -Function New-ESAdapterEvidenceSet,New-ESAdapterReceipt,Test-ESAdapterEvidence,ConvertTo-ESPlatformEvidenceInput,Submit-ESAdapterEvidenceToTaskContext,Invoke-ESAdapterObservationVerifier,Get-EvidenceHash
