Set-StrictMode -Version Latest;$ErrorActionPreference='Stop'
function Get-AdapterHash($v){$sha=[Security.Cryptography.SHA256]::Create();try{([BitConverter]::ToString($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes(($v|ConvertTo-Json -Depth 30 -Compress)))).Replace('-','').ToLowerInvariant())}finally{$sha.Dispose()}}
function New-ESOpenHandsConversation {param([Parameter(Mandatory)][string]$ConversationId,[string]$TaskId) [pscustomobject]@{schemaVersion=1;conversationId=$ConversationId;taskId=$TaskId;status='idle';sequence=0;events=@();toolAllowlist=@('read','patch','test');environmentTrusted=$false}}
function Invoke-ESOpenHandsStep {param([Parameter(Mandatory)]$State,[Parameter(Mandatory)][ValidateSet('observe','decide','tool','verify')][string]$Kind,[string]$Tool='',[string]$Result='') if($Kind -eq 'tool' -and $State.toolAllowlist -notcontains $Tool){throw 'tool-denied'};$e=[ordered]@{sequence=([int]$State.sequence+1);kind=$Kind;tool=$Tool;resultHash=Get-AdapterHash $Result};$e.eventHash=Get-AdapterHash $e;$State.sequence=$e.sequence;$State.events=@($State.events)+[pscustomobject]$e;$State.status=$(if($Kind -eq 'verify'){'verified'}else{'running'});$State}
function Set-ESOpenHandsEnvironment {param([Parameter(Mandatory)]$State,[Parameter(Mandatory)][bool]$Trusted) $State.environmentTrusted=$Trusted;$State}
function Invoke-ESSweAgentPatchTest {param([Parameter(Mandatory)][string]$RepositoryRoot,[Parameter(Mandatory)][string]$Patch,[Parameter(Mandatory)][bool]$EnvironmentTrusted,[scriptblock]$Test) if(-not $EnvironmentTrusted){throw 'environment-untrusted'};if([string]::IsNullOrWhiteSpace($Patch)){throw 'invalid-patch'};$testResult=&$Test;if(-not $testResult){throw 'test-failed'};[pscustomobject]@{schemaVersion=1;repositoryRoot=$RepositoryRoot;diffHash=Get-AdapterHash $Patch;testStatus='passed';testResultHash=Get-AdapterHash $testResult.ToString();receiptHash=''}|%{$_.receiptHash=Get-AdapterHash $_;$_}
}
Export-ModuleMember -Function New-ESOpenHandsConversation,Invoke-ESOpenHandsStep,Set-ESOpenHandsEnvironment,Invoke-ESSweAgentPatchTest,Get-AdapterHash
